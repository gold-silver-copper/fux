;; The keys a viewer starts with: a chord, a caption and a heading, and what
;; it does. The prefix menu is drawn from these alone. `bind-verb` keys act
;; at once, even while a binding runs; the rest call the commands in the
;; library, the way your own view.grift can.
(bind-key "C-b v" "split side by side" "Panes" (lambda! () (split-new "columns")))
(bind-key "C-b s" "split stacked" "Panes" (lambda! () (split-new "rows")))
(bind-key "C-b c" "new shell in this tab" "Panes" new-shell-here)
(bind-key "C-b x" "close pane" "Panes" (lambda! () (confirm-close-pane (focused))))
(bind-key "C-b z" "zoom or restore" "Panes" (lambda! () (edit! "zoom" (focused))))
(bind-key "C-b [" "history in a pager" "Panes" history)
(bind-verb "C-b f" "fit pane to its tile" "Panes" "fit")
(bind-group "C-b a" "pane actions" "Panes")
(bind-key "C-b a r" "rename pane" "Pane actions" (lambda! () (rename-pane (focused))))
(bind-key "C-b a x" "close pane" "Pane actions" (lambda! () (confirm-close-pane (focused))))
(bind-key "C-b a k" "terminate its program" "Pane actions" (lambda! () (signal (focused) "TERM")))
(bind-key "C-b a s" "swap with…" "Pane actions" (lambda! () (swap-with (focused))))
(bind-key "C-b a t" "move to tab…" "Pane actions" (lambda! () (move-to-tab (focused))))
(bind-key "C-b a n" "move to a new tab" "Pane actions" (lambda! () (move-to-new-tab (focused))))
(bind-key "C-b a w" "move to workspace…" "Pane actions" (lambda! () (move-to-workspace (focused))))
(bind-key "C-b a W" "move to a new workspace" "Pane actions" (lambda! () (move-to-new-workspace (focused))))
(bind-group "C-b a m" "reorder" "Pane actions" #true)
(bind-key "C-b a m h" "move pane earlier" "Reorder" (lambda! () (edit! "move" (focused) "earlier")))
(bind-key "C-b a m l" "move pane later" "Reorder" (lambda! () (edit! "move" (focused) "later")))

(bind-verb "C-b o" "next pane" "Focus" "next-pane")
(bind-verb "C-b O" "previous pane" "Focus" "previous-pane")
(bind-verb "C-b ;" "last pane" "Focus" "last-pane")
(bind-verb "C-b Left" "focus left" "Focus" "focus-left")
(bind-verb "C-b Down" "focus down" "Focus" "focus-down")
(bind-verb "C-b Up" "focus up" "Focus" "focus-up")
(bind-verb "C-b Right" "focus right" "Focus" "focus-right")
(bind-key "C-b g" "go to a pane…" "Focus" choose-pane)

(bind-group "C-b r" "resize" "Layout" #true)
(bind-key "C-b r h" "border left" "Resize" (lambda! () (edit! "border" (focused) "left" "1")))
(bind-key "C-b r j" "border down" "Resize" (lambda! () (edit! "border" (focused) "down" "1")))
(bind-key "C-b r k" "border up" "Resize" (lambda! () (edit! "border" (focused) "up" "1")))
(bind-key "C-b r l" "border right" "Resize" (lambda! () (edit! "border" (focused) "right" "1")))
(bind-group "C-b m" "move pane" "Layout" #true)
(bind-key "C-b m h" "move left" "Move" (lambda! () (edit! "move" (focused) "left")))
(bind-key "C-b m j" "move down" "Move" (lambda! () (edit! "move" (focused) "down")))
(bind-key "C-b m k" "move up" "Move" (lambda! () (edit! "move" (focused) "up")))
(bind-key "C-b m l" "move right" "Move" (lambda! () (edit! "move" (focused) "right")))

(bind-verb "C-b n" "next tab" "Tabs" "next-tab")
(bind-verb "C-b p" "previous tab" "Tabs" "previous-tab")
(bind-verb "C-b l" "last tab" "Tabs" "last-tab")
(bind-verb "C-b 1" "tab 1" "Tabs" "go-to-tab" 1)
(bind-verb "C-b 2" "tab 2" "Tabs" "go-to-tab" 2)
(bind-verb "C-b 3" "tab 3" "Tabs" "go-to-tab" 3)
(bind-verb "C-b 4" "tab 4" "Tabs" "go-to-tab" 4)
(bind-verb "C-b 5" "tab 5" "Tabs" "go-to-tab" 5)
(bind-verb "C-b 6" "tab 6" "Tabs" "go-to-tab" 6)
(bind-verb "C-b 7" "tab 7" "Tabs" "go-to-tab" 7)
(bind-verb "C-b 8" "tab 8" "Tabs" "go-to-tab" 8)
(bind-verb "C-b 9" "tab 9" "Tabs" "go-to-tab" 9)
(bind-group "C-b t" "tabs" "Tabs")
(bind-key "C-b t n" "new tab" "Tabs" new-tab)
(bind-key "C-b t g" "choose a tab…" "Tabs" choose-tab)
(bind-key "C-b t r" "rename tab" "Tabs" (lambda! () (rename-tab (shown-tab))))
(bind-key "C-b t x" "close tab" "Tabs" (lambda! () (confirm-close-tab (shown-tab))))
(bind-group "C-b t m" "reorder" "Tabs" #true)
(bind-key "C-b t m h" "move tab earlier" "Reorder" (lambda! () (arrange "tab" "move" (shown-tab) "earlier")))
(bind-key "C-b t m l" "move tab later" "Reorder" (lambda! () (arrange "tab" "move" (shown-tab) "later")))

(bind-verb "C-b )" "next workspace" "Workspaces" "next-workspace")
(bind-verb "C-b (" "previous workspace" "Workspaces" "previous-workspace")
(bind-verb "C-b L" "last workspace" "Workspaces" "last-workspace")
(bind-group "C-b w" "workspaces" "Workspaces")
(bind-key "C-b w n" "new workspace" "Workspaces" new-workspace)
(bind-key "C-b w g" "choose a workspace…" "Workspaces" choose-workspace)
(bind-key "C-b w r" "rename workspace" "Workspaces" (lambda! () (rename-workspace (shown-workspace))))
(bind-key "C-b w x" "close workspace" "Workspaces" (lambda! () (confirm-close-workspace (shown-workspace))))
(bind-verb "C-b w h" "previous workspace" "Workspaces" "previous-workspace")
(bind-verb "C-b w l" "next workspace" "Workspaces" "next-workspace")
(bind-group "C-b w m" "reorder" "Workspaces" #true)
(bind-key "C-b w m h" "move workspace earlier" "Reorder" (lambda! () (arrange "workspace" "move" (shown-workspace) "earlier")))
(bind-key "C-b w m l" "move workspace later" "Reorder" (lambda! () (arrange "workspace" "move" (shown-workspace) "later")))

(bind-key "C-b :" "command line" "Session" command-line)
(bind-key "C-b ?" "list every key" "Session" key-list)
(bind-verb "C-b d" "detach" "Session" "detach")
(bind-verb "C-b C-b" "send C-b to the pane" "Session" "literal")
