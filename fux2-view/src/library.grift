;; fux2's commands, in grift, over the viewer's primitives (see the README).
;; The keys in defaults.grift call them by name, and your view.grift may
;; redefine any of them: it is loaded after this.

;; Where the command line's text runs.
(define! top (current-context))

;; The viewer's own actions: they act at once.
(define! next-pane (lambda! () (act "next-pane")))
(define! previous-pane (lambda! () (act "previous-pane")))
(define! last-pane (lambda! () (act "last-pane")))
(define! focus-left (lambda! () (act "focus-left")))
(define! focus-right (lambda! () (act "focus-right")))
(define! focus-up (lambda! () (act "focus-up")))
(define! focus-down (lambda! () (act "focus-down")))
(define! next-tab (lambda! () (act "next-tab")))
(define! previous-tab (lambda! () (act "previous-tab")))
(define! last-tab (lambda! () (act "last-tab")))
(define! go-to-tab (lambda! (n) (act "go-to-tab" n)))
(define! next-workspace (lambda! () (act "next-workspace")))
(define! previous-workspace (lambda! () (act "previous-workspace")))
(define! last-workspace (lambda! () (act "last-workspace")))
(define! show-tab (lambda! (tab) (act "show-tab" tab)))
(define! show-workspace (lambda! (space) (act "show-workspace" space)))
(define! fit (lambda! () (act "fit")))
(define! detach (lambda! () (act "detach")))
(define! run-chord (lambda! (chord) (act "chord" chord)))

;; A layout edit, then the tiles it changed resized to fit them, in this
;; viewer only. `arrange` alone edits and resizes nothing.
(define! edit! (lambda! words (fit-after (apply arrange words))))

;; A pane's name, without the `@ID` of its life.
(define! name-of (lambda! (pane) (first (string-split pane "@"))))

;; The row of `rows` whose first item is `id`.
(define! row-of (lambda! (rows id)
  (let! ((found (filter (lambda! (row) (equal? (first row) id)) rows)))
    (if! (empty-list? found) (raise (error (quote! missing) id)) (first found)))))

;; Places a pane just started with `place`, a function of the pane, and
;; tries once more if that loses a race. If it still fails, it says the
;; pane is running and has no tile: it never starts another or kills it.
(define! place-new! (lambda! (pane place)
  (catch-kind! (place pane) fux2-error first-try
    (catch-kind! (place pane) fux2-error second-try
      (raise (error (quote! not-placed) (join pane " is running but has no tile") second-try))))
  (focus pane)))

;; A shell beside the focused pane: axis is "columns" or "rows".
(define! split-new (lambda! (axis)
  (let! ((target (focused)) (pane (start-new "shell")))
    (place-new! pane (lambda! (p) (edit! "split" target p (join "--" axis)))))))

;; A shell in the tab shown.
(define! new-shell-here (lambda! ()
  (let! ((tab (shown-tab)) (pane (start-new "shell")))
    (place-new! pane (lambda! (p) (edit! "move" p "--tab" tab))))))

;; The focused pane's history in a pager, below it; it closes when the
;; pager ends.
(define! history (lambda! ()
  (let! ((target (focused))
         (pane (start-new "history" (fux2-program) "page" target "--close-pane")))
    (place-new! pane (lambda! (p) (edit! "split" target p "--rows"))))))

;; Asks, as a list with one row, Yes, and calls `then` only if it is chosen.
(define! confirm (lambda! (question then)
  (pick question (list (list "yes" "Yes")) (lambda! (answer) (then)))))

;; Ends a pane and takes its tile away. A pane already gone just loses its
;; tile, and a routed pane has no tile once it is gone; any other failure
;; of either step is said.
(define! close-pane (lambda! (pane)
  (catch-kind! (kill pane) fux2-gone gone #inert)
  (catch-kind! (edit! "remove" pane) fux2-gone gone #inert)))
(define! confirm-close-pane (lambda! (pane)
  (confirm (join "close pane " (pane-label pane) "?") (lambda! () (close-pane pane)))))

;; How lists name things: a pane by its name and title, a tab or workspace
;; by its id and title.
(define! pane-label (lambda! (pane)
  (let! ((rows (filter (lambda! (row) (equal? (first row) pane)) (panes)))
         (title (if! (empty-list? rows) "" (third (first rows)))))
    (if! (equal? title "") (name-of pane) (join (name-of pane) " " title)))))
(define! panes-of (lambda! (tab) (filter (lambda! (row) (equal? (second row) tab)) (panes))))
(define! panes-text (lambda! (rows)
  (string-join (map (lambda! (row) (pane-label (first row))) rows) ", ")))
(define! tabs-of (lambda! (space) (filter (lambda! (row) (equal? (third row) space)) (tabs))))
(define! tab-row (lambda! (row current)
  (list (first row) (join (first row) " " (second row) " — " (panes-text (panes-of (first row))))
        (equal? (first row) current))))
(define! count-of (lambda! (n noun)
  (join (integer-to-string n) " " noun (if! (equal? n 1) "" "s"))))
(define! workspace-panes (lambda! (space)
  (apply append (map (lambda! (tab) (panes-of (first tab))) (tabs-of space)))))
(define! workspace-row (lambda! (row current)
  (list (first row) (join (first row) " " (second row) " — " (panes-text (workspace-panes (first row))))
        (equal? (first row) current))))

;; Lists. A tab or workspace list renames with r and closes with x.
(define! choose-tab (lambda! ()
  (let! ((here (shown-tab)))
    (pick "tabs" (map (lambda! (row) (tab-row row here)) (tabs-of (shown-workspace)))
      show-tab
      (list (list "r" "rename" rename-tab) (list "x" "close" confirm-close-tab))))))
(define! choose-workspace (lambda! ()
  (let! ((here (shown-workspace)))
    (pick "workspaces"
      (map (lambda! (row)
             (let! ((space (first row)) (tabs-here (length (tabs-of (first row)))))
               (list space
                     (join space " " (second row) " — "
                           (count-of tabs-here "tab") ", " (count-of (length (workspace-panes space)) "pane"))
                     (equal? space here))))
           (workspaces))
      show-workspace
      (list (list "r" "rename" rename-workspace) (list "x" "close" confirm-close-workspace))))))
(define! choose-pane (lambda! ()
  (pick "panes" (map (lambda! (row) (list (first row) (pane-label (first row)) (equal? (first row) (focused)))) (panes))
    focus)))
(define! swap-with (lambda! (pane)
  (let! ((others (filter (lambda! (row) (not? (equal? (first row) pane))) (panes-of (shown-tab)))))
    (when! (empty-list? others) (raise (error (quote! fail) "only one pane in the source tab")))
    (pick (join "swap " (pane-label pane) " with")
      (map (lambda! (row) (list (first row) (pane-label (first row)))) others)
      (lambda! (other) (edit! "swap" pane other))))))
(define! move-to-tab (lambda! (pane)
  (let! ((here (shown-tab)))
    (pick (join "move " (pane-label pane) " to tab")
      (map (lambda! (row) (tab-row row here)) (tabs-of (shown-workspace)))
      (lambda! (tab) (edit! "move" pane "--tab" tab))))))
(define! move-to-workspace (lambda! (pane)
  (let! ((here (shown-workspace)))
    (pick (join "move " (pane-label pane) " to workspace")
      (map (lambda! (row) (workspace-row row here)) (workspaces))
      (lambda! (space) (edit! "move" pane "--workspace" space))))))
(define! move-to-new-tab (lambda! (pane)
  (show-tab (made (edit! "move" pane "--tab" "new")))
  (focus pane)))
(define! move-to-new-workspace (lambda! (pane)
  (show-workspace (made (edit! "move" pane "--workspace" "new")))
  (focus pane)))

;; Prompts, filled with the name now.
(define! rename-pane (lambda! (pane)
  (let! ((rows (filter (lambda! (row) (equal? (first row) pane)) (panes))))
    (read-line (join "rename pane " (name-of pane)) (if! (empty-list? rows) "" (third (first rows)))
      (lambda! (title) (arrange "title" pane title))))))
(define! rename-tab (lambda! (tab)
  (read-line (join "rename tab " tab) (second (row-of (tabs) tab))
    (lambda! (title) (arrange "tab" "rename" tab title)))))
(define! rename-workspace (lambda! (space)
  (read-line (join "rename workspace " space) (second (row-of (workspaces) space))
    (lambda! (title) (arrange "workspace" "rename" space title)))))

;; Tabs and workspaces: a new one starts with a shell; closing one ends
;; its panes.
(define! new-tab (lambda! ()
  (let! ((tab (made (arrange "tab" "new" "--after" (shown-tab)))) (pane (start-new "shell")))
    (show-tab tab)
    (place-new! pane (lambda! (p) (edit! "move" p "--tab" tab))))))
(define! new-workspace (lambda! ()
  (let! ((space (made (arrange "workspace" "new"))) (pane (start-new "shell")))
    (show-workspace space)
    (place-new! pane (lambda! (p) (edit! "move" p "--workspace" space))))))
;; Closing ends the panes the shared layout has there when it closes, not
;; those this viewer saw: one moved away meanwhile is left alone.
(define! confirm-close-tab (lambda! (tab)
  (confirm (join "close tab " tab " " (second (row-of (tabs) tab)) "?")
    (lambda! () (arrange "tab" "close" tab "--end-panes")))))
(define! confirm-close-workspace (lambda! (space)
  (confirm (join "close workspace " space " " (second (row-of (workspaces) space)) "?")
    (lambda! () (arrange "workspace" "close" space "--end-panes")))))

;; Every form of `text`, in turn, in the top-level context: the last one's
;; value. Text that does not read is an error, wherever it is.
(define! run-text (lambda! (text)
  (let! ((step (lambda! (from last)
                 (let! ((form (read-form text from)))
                   (if! (empty-list? form) last
                     (step (third form) (evaluate (first form) top)))))))
    (step 0 #inert))))

;; Type grift; the answer shows in the bar's corner.
(define! command-line (lambda! ()
  (read-line ":" "" (lambda! (text) (say (value-to-string (run-text text)))))))

;; Every key, to read or to run.
(define! key-list (lambda! ()
  (pick "keys"
    (map (lambda! (b) (list (first b) (join (first b) "  " (second b) "  (" (third b) ")")))
         (key-bindings))
    run-chord)))

;; What a mouse drag of a border does when it is let go.
(define! drag-border (lambda! (pane way cells version)
  (edit! "border" pane way cells "--if" version)))
