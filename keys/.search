#!/bin/sh
# What the search key runs in a pane of its own: asks for words, lists every line
# of every other pane of the session that has them as they are (history and screen,
# wrapped lines whole, ASCII letters of either case), and opens the one chosen in the
# editor: that pane's text, made anew, at that line's number. `.text` makes the text, `.pick` does the
# choosing, `.edit` the opening.
if [ "$1" = --open ]; then
  # KEY is WORKSPACE/PANE:LINE.
  f=$(mktemp "$FUX_DIR/.text.XXXXXX") || exit
  FUX_PANE=$FUX_DIR/${2%:*} "$FUX_KEYS/.text" "$f" > /dev/null
  exec "$FUX_KEYS/.edit" "$f" "${2##*:}"
fi
printf 'search every pane for: '
IFS= read -r words
[ -n "$words" ] || exit
list=$(mktemp "$FUX_DIR/.pick.XXXXXX") && text=$FUX_PANE/text || exit
for p in "$FUX_DIR"/*/*/; do
  p=${p%/}
  [ -f "$p/main/lines" ] && [ ! "$p" -ef "$FUX_PANE" ] || continue
  FUX_PANE=$p "$FUX_KEYS/.text" "$text" > /dev/null
  LC_ALL=C grep -n -i -F -e "$words" "$text" | LC_ALL=C sed "s|^[0-9]*|${p#"$FUX_DIR"/}:&	${p#"$FUX_DIR"/} &|"
done > "$list"
[ -s "$list" ] || { rm -f "$list"; echo "no pane has that: Enter closes this"; read -r _; exit; }
exec "$FUX_KEYS/.pick" "$list" "$FUX_KEYS/.search" --open
