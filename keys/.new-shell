# Start the default shell in the focused pane's directory if its program reported one.
new_shell() {
  IFS= read -r d 2>/dev/null < "$FUXN_PANE/cwd" && [ -d "$d" ] && cd "$d"
  p=$(
    # A split starts at the size predicted by the viewer. A new tab inherits its size.
    if [ "$#" -eq 2 ]; then export COLUMNS="${2%x*}" LINES="${2#*x}"; fi
    fux start "$FUXN_WS/" -- "$FUXN_KEYS/.shell"
  ) || return
  if [ "$#" -eq 2 ] && [ -n "$FUXN_PANE" ]; then
    # Anchor to the pane on which the key was pressed, even if focus has moved.
    fux layout split "$1" "${p##*/}" beside "${FUXN_PANE##*/}"
  else
    fux layout pane "${p##*/}"
  fi
}
