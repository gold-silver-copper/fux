#!/bin/sh
# .edit FILE [LINE]: opens FILE in a tab of its own, in the editor, at LINE; FILE
# is removed when that ends. LINE is 1 if not given.
# How the editor is run is `$FUXN_EDIT` if that is set (a line of sh: the file is its
# `$1`, the line its `$2`, which it may leave out), else `$EDITOR`, `$PAGER` or less,
# with the line as the `case` below knows that editor to take it. The README has it in
# full ("Keys are scripts").
if [ "$1" = --in ]; then
  # In the tab's pane. The file is in the pane's own folder from here on, so it
  # goes with the pane however that is closed (`.shell` removes the folder when
  # the editor ends; the close key removes it under a running one).
  # (One that cannot be moved there has gone, or the pane is going: mv has said why, and Enter closes the pane.)
  mv "$2" "$FUXN_PANE/text" || { rm -f "$2"; read -r _; exit; }
  f=$FUXN_PANE/text n=$3
  set -f; set -- ${EDITOR:-${PAGER:-less}}
  if [ -n "$FUXN_EDIT" ]; then sh -c "$FUXN_EDIT" sh "$f" "$n"
  else case ${1##*/} in
    vi|vim|nvim|nano|emacs) "$@" "+$n" "$f" ;;
    less) "$@" "+${n}g" "$f" ;;
    hx|helix) "$@" "$f:$n" ;;
    *) "$@" "$f" ;;
  esac; fi || { echo "the editor ended with $?: Enter closes this"; read -r _; }
  exit 0
fi
p=$(fux start -- "$FUXN_KEYS/.shell" "$FUXN_KEYS/.edit" --in "$1" "${2:-1}") || { rm -f "$1"; exit; }
# (An editor that is done by now has taken its pane with it: then there is none to show.)
fux layout pane "${p##*/}" 2> /dev/null || :
