#!/bin/sh
# .edit FILE [LINE]: opens FILE in a tab of its own, in the editor, at LINE; FILE
# is removed when that ends.
# How the editor is run is `$FUXN_EDIT` if that is set: a command in which `%f`
# is the file and `%l` the line (`FUXN_EDIT='hx %f:%l'`; split at spaces,
# nothing else expanded; without `%f` the file is put last). If not, it is
# `$EDITOR`, else `$PAGER`, else less, with the line in the form the editor is
# known to take (vi, vim, nvim, nano, emacs, less, hx, helix) and without it
# for any other: an editor behind a launcher of another name wants `FUXN_EDIT`.
put() {
  rest=$1 word=
  while :; do
    case $rest in *"$2"*) word=$word${rest%%"$2"*}$3 rest=${rest#*"$2"} ;; *) break ;; esac
  done
  word=$word$rest
}
if [ "$1" = --in ]; then
  # In the tab's pane. The file is in the pane's own folder from here on, so it
  # goes with the pane however that is closed (`.shell` removes the folder when
  # the editor ends; the close key removes it under a running one). An editor
  # that failed first waits for Enter, so that what it said can be read.
  f=$2 n=$3
  shift 3
  mv "$f" "$FUXN_PANE/text" 2>/dev/null && f=$FUXN_PANE/text
  for word do
    shift
    put "$word" %f "$f"
    put "$word" %l "$n"
    set -- "$@" "$word"
  done
  "$@"
  code=$?
  rm -f "$f"
  [ "$code" -eq 0 ] || { echo "the editor ended with $code: Enter closes this"; read -r _; }
  exit 0
fi
f=$1 n=${2:-1}
set -f
if [ -n "$FUXN_EDIT" ]; then
  set -- $FUXN_EDIT
  case " $* " in *%f*) ;; *) set -- "$@" %f ;; esac
else
  set -- ${EDITOR:-${PAGER:-less}}
  case ${1##*/} in
    vi|vim|nvim|nano|emacs) set -- "$@" +%l %f ;;
    less) set -- "$@" +%lg %f ;;
    hx|helix) set -- "$@" %f:%l ;;
    *) set -- "$@" %f ;;
  esac
fi
p=$(fux start "$FUXN_WS/" -- "$FUXN_KEYS/.shell" "$FUXN_KEYS/.edit" --in "$f" "$n" "$@") || { rm -f "$f"; exit; }
# An editor that is done at once has taken its pane with it already.
[ ! -d "$p" ] || fux layout pane "${p##*/}"
