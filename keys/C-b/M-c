#!/bin/sh
# pane text in colour, in less
# group: Panes
# `.text` makes the file from the styled files, `.edit` opens it: in `less -R`
# whatever `$EDITOR` is, with `-+F` so that a short text stays open too.
[ -n "$FUX_PANE" ] || exit 0
f=$(mktemp "$FUX_DIR/.text.XXXXXX") || exit
"$FUX_KEYS/.text" "$f" styled > /dev/null
FUX_EDIT='less -+F -R +G "$1"' exec "$FUX_KEYS/.edit" "$f"
