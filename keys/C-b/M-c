#!/bin/sh
# history in colour, in less
# group: Panes
# `.text` makes the file from the styled files, `.edit` opens it: in `less -R`
# whatever `$EDITOR` is, with `-+F` so that a short text stays open too.
[ -n "$FUXN_PANE" ] || exit 0
f=$(mktemp "$FUXN_DIR/.text.XXXXXX") || exit
"$FUXN_KEYS/.text" "$f" styled > /dev/null
FUXN_EDIT='less -+F -R +G %f' exec "$FUXN_KEYS/.edit" "$f"
