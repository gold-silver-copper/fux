#!/bin/sh
# pane text in colour, in less
# group: Panes
# `.text` makes the file from the styled files, `.edit` opens it: in `less -R`
# whatever your editor is, with `-+F` so that a short text stays open too.
[ -L pane ] || exit 0
k=$(readlink keys); f=$(mktemp "$(readlink session)/.text.XXXXXX") || exit
"$k/.text" pane "$f" styled > /dev/null
exec "$k/.edit" "$(readlink workspace)" "$f" 1 less -+F -R +G
