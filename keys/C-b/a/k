#!/bin/sh
# send TERM to the pane's program
# group: Pane actions
# `state` says whether the program runs and `status` what its number is: the
# number of a program that ended may be another's by now. (A default shell
# pane's program is `.shell`, which ignores TERM as a shell does; a pane
# started with a program of its own gets it.)
read -r state < "$FUXN_PANE/state" 2>/dev/null
[ "$state" = running ] || { echo "no program is running in this pane"; exit; }
pid=$(sed -n 's/^pid //p' "$FUXN_PANE/status")
[ -n "$pid" ] && kill -TERM "$pid"
