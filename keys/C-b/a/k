#!/bin/sh
# send TERM to the running command
# group: Pane actions
# Only while it runs: the number of a program that ended may be another's by now.
grep -q '^state running' "$FUXN_PANE/status" 2>/dev/null || { echo "no program is running in this pane"; exit; }
kill -TERM "$(sed -n 's/^pid //p' "$FUXN_PANE/status")"
