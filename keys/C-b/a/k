#!/bin/sh
# send TERM to the pane's program
# group: Pane actions
# Line 1 of the screen says what the program's number is and whether it runs:
# the number of a program that ended may be another's by now. (A default
# shell pane's program is `.shell`, which ignores TERM as a shell does; a
# pane started with a program of its own gets it.)
line=$(head -n 1 "$FUXN_PANE/screen" 2>/dev/null)
case " $line " in *" state=running "*) ;; *) echo "no program is running in this pane"; exit ;; esac
pid=${line#pid=}
kill -TERM "${pid%% *}"
