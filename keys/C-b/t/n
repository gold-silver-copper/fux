#!/bin/sh
# new tab
# group: Tabs
# The pane's shell runs inside a wrapper that removes the pane's folder when the
# shell ends: that is this script's choice, not fux's. A shell killed outright
# leaves its folder, for the close key or `rm -r`.
p=$(fux start "$FUXN_WS/" -- sh -c '"${SHELL:-sh}"; rm -rf "$FUXN_PANE"') || exit
fux layout pane "${p##*/}"
