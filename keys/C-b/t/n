#!/bin/sh
# new tab
# group: Tabs
p=$(fux start "$FUXN_WS/") || exit
fux layout pane "${p##*/}"
# When the shell ends, its pane goes: that is this script's choice, not fux's.
h=$(sed -n 2p "$p/status")
# ...unless another pane has that name by then: only the pane of the holder we waited for is removed.
(fux wait "$p" >/dev/null; [ "$(sed -n 2p "$p/status" 2>/dev/null)" = "$h" ] && rm -rf "$p") >/dev/null 2>&1 &
