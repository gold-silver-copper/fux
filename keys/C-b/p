#!/bin/sh
# the editor at the previous prompt
# group: Panes
# A shell that marks its prompts (OSC 133) says where each one is: the pane's
# `marks` has the line numbers. The pane's text is opened in the editor
# at the last marked prompt but one, wherever the cursor is.
[ -s "$FUX_PANE/marks" ] || { echo "no marks here: the shell does not mark its prompts (OSC 133)"; exit; }
f=$(mktemp "$FUX_DIR/.text.XXXXXX") || exit
add=$("$FUX_KEYS/.text" "$f" '' "$f.marks") || { rm -f "$f" "$f.marks"; exit; }
# (The marks of the same read as the text. The only prompt there is, if there is one only.)
line=$(awk '$3 == "prompt" { before = last; last = $1 } END { print (before != "" ? before : last) }' "$f.marks"; rm -f "$f.marks")
[ -n "$line" ] || { rm -f "$f"; echo "no prompt is marked here"; exit; }
n=$((line + add))
[ "$n" -ge 1 ] || n=1
exec "$FUX_KEYS/.edit" "$f" "$n"
