#!/bin/sh
# the editor at the previous prompt
# group: Panes
# A shell that marks its prompts (OSC 133) says where each one is: the pane's
# `marks` has the line numbers. The pane's text is opened in the editor
# at the last marked prompt but one, wherever the cursor is.
[ -s "$FUXN_PANE/marks" ] || { echo "no marks here: the shell does not mark its prompts (OSC 133)"; exit; }
[ ! -e "$FUXN_PANE/screen.main" ] || { echo "this pane shows a program's own screen: the marks are of the shell's"; exit; }
# (The only prompt there is, if there is one only.)
line=$(awk '$3 == "prompt" { before = last; last = $1 } END { print (before != "" ? before : last) }' "$FUXN_PANE/marks")
[ -n "$line" ] || { echo "no prompt is marked here"; exit; }
f=$(mktemp "$FUXN_DIR/.text.XXXXXX") || exit
add=$("$FUXN_KEYS/.text" "$f") || { rm -f "$f"; exit; }
n=$((line + add))
[ "$n" -ge 1 ] || n=1
exec "$FUXN_KEYS/.edit" "$f" "$n"
