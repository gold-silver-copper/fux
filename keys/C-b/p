#!/bin/sh
# the editor at the previous prompt
# group: Panes
# A shell that marks its prompts (OSC 133) says where each one is: the pane's
# `marks` has the line numbers. The pane's whole text is opened in the editor
# at the prompt before the one being typed at.
[ -n "$FUXN_PANE" ] || exit 0
[ -s "$FUXN_PANE/marks" ] || { echo "no marks here: the shell does not mark its prompts (OSC 133)"; exit; }
f=$(mktemp "$FUXN_DIR/.text.XXXXXX") || exit
before=$("$FUXN_KEYS/.text" "$f")
read -r top 2>/dev/null < "$FUXN_PANE/top"
line=$(awk '$2 == "prompt" { before = last; last = $1 } END { print (before != "" ? before : last) }' "$FUXN_PANE/marks")
n=$((line - ${top:-0} + before + 1))
[ "$n" -ge 1 ] || n=1
exec "$FUXN_KEYS/.edit" "$f" "$n"
