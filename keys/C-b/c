#!/bin/sh
# history in the editor
# group: Panes
# The pane's text (older history, history, then the screen) as one private file,
# opened in $EDITOR, else $PAGER, else less (at its end where the editor is
# known to take a line number); removed when that ends.
[ -n "$FUX_PANE" ] || exit 0
f=$(mktemp "$FUX_DIR/.text.XXXXXX") || exit
# The screen is read first, without its first line and the blank rows at its end:
# a line that scrolls off meanwhile is then there twice, never missing.
screen=$(tail -n +2 "$FUX_PANE/screen" | awk '{ row[NR] = $0; if ($0 != "") last = NR } END { for (i = 1; i <= last; i++) print row[i] }')
{ cat "$FUX_PANE/history.1" "$FUX_PANE/history" 2>/dev/null; printf '%s\n' "$screen"; } > "$f"
n=$(($(wc -l < "$f")))
# $EDITOR may hold arguments (split at spaces, nothing else expanded). Only an
# editor known to read a line number is given one.
set -f
set -- ${EDITOR:-${PAGER:-less}}
case ${1##*/} in
  vi|vim|nvim|nano|emacs) set -- "$@" "+$n" ;;
  less) set -- "$@" +G ;;
esac
# The file goes when the editor ends; the tab too, unless the editor failed (its words stay to be read).
p=$(fux start "$FUX_WS/" -- sh -c 'f=$1; shift; "$@" "$f"; code=$?; rm -f "$f"; exit $code' sh "$f" "$@") || { rm -f "$f"; exit; }
fux layout pane "${p##*/}"
h=$(sed -n 2p "$p/status")
(fux wait "$p" | grep -q '^state exited 0' && [ "$(sed -n 2p "$p/status" 2>/dev/null)" = "$h" ] && rm -rf "$p"; rm -f "$f") >/dev/null 2>&1 &
