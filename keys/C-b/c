#!/bin/sh
# history in the editor
# group: Panes
# The pane's text (older history, history, then the screen) as one private file,
# opened in the editor at its end: `.text` makes the file, `.edit` opens it.
[ -n "$FUXN_PANE" ] || exit 0
f=$(mktemp "$FUXN_DIR/.text.XXXXXX") || exit
"$FUXN_KEYS/.text" "$f" > /dev/null
exec "$FUXN_KEYS/.edit" "$f" "$(($(wc -l < "$f")))"
