#!/bin/sh
# pane text in the editor
# group: Panes
# `.text` makes the file (the pane's text), `.edit` opens it, at its last line
# (in an editor whose way to a line it knows, or that `FUXN_EDIT` tells it).
[ -n "$FUXN_PANE" ] || exit 0
f=$(mktemp "$FUXN_DIR/.text.XXXXXX") || exit
"$FUXN_KEYS/.text" "$f" > /dev/null
exec "$FUXN_KEYS/.edit" "$f" "$(($(wc -l < "$f")))"
