#!/bin/sh
# yes, close this pane
# Its folder leaves the workspace at once, so its tile goes; its holder sees
# `in` gone within two seconds, hangs up the program and leaves; then nothing
# writes there any more and the folder is removed. No `kill`: a folder removed
# under a holder still writing was left behind half the time.
[ -L pane ] || exit 0
gone=$(mktemp -d "$(readlink session)/.closed.XXXXXX") || exit
mv "$(readlink pane)" "$gone/pane" || { rmdir "$gone"; exit 1; }
rm -f "$gone/pane/in"
(fux wait "$gone/pane" >/dev/null; rm -rf "$gone") >/dev/null 2>&1 &
