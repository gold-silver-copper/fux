#!/bin/sh
# find a workspace
# group: Find
# A list of the session's folders (name, and what is in each but its layout) in a pane of its own; the
# viewer is told to show the one chosen.
list=$(mktemp "$FUXN_DIR/.pick.XXXXXX") || exit
for w in "$FUXN_DIR"/*/; do
  w=${w%/}
  printf '%s\t%s\n' "${w##*/}" "$(ls "$w" | grep -v -x -e layout -e layout.new | tr '\n' ' ')"
done > "$list"
# (The pane has no word for the viewer: it is given the viewer's FIFO to write to, if that is still there.)
exec "$FUXN_KEYS/.pick" --tab "$list" sh -c '[ -p "$0" ] && echo "workspace $1" 1<>"$0"' "$FUXN_VIEW"
