#!/bin/sh
# find a pane
# group: Find
# A list of this workspace's panes that have a screen (name, title, the row its cursor is on) in a
# pane of its own; the one chosen gets the keys. `.pick` does the choosing.
list=$(mktemp "$(readlink session)/.pick.XXXXXX") || exit
for p in workspace/*/; do
  [ -e "$p/shown/screen" ] || continue
  read -r row _ 2>/dev/null < "$p/cursor" || row=0
  printf '%s\t%s  %s\n' "$(basename "$p")" "$(head -n 1 "$p/title" 2>/dev/null)" "$(sed -n "$((row + 1))p" "$p/shown/screen")"
done > "$list"
exec "$(readlink keys)/.pick" --tab "$list"
