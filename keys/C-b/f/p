#!/bin/sh
# find a pane
# group: Find
# (The tab shown before the list's own is shown first, so that it is the tab
# shown before the one chosen, and `fux layout tab -` goes back to it.)
# A list of this workspace's panes (name, title, the row its cursor is on) in a
# pane of its own; the one chosen gets the keys. `.pick` does the choosing.
list=$(mktemp "$FUXN_DIR/.pick.XXXXXX") || exit
for p in "$FUXN_DIR/$FUXN_WS"/*/; do
  [ -e "$p/screen" ] || continue
  row=0
  read -r row _ 2>/dev/null < "$p/cursor"
  case $row in '' | *[!0-9]*) row=0 ;; esac
  printf '%s\t%s  %s\n' "$(basename "$p")" "$(head -n 1 "$p/title" 2>/dev/null)" "$(sed -n "$((row + 1))p" "$p/screen")"
done > "$list"
p=$(fux start "$FUXN_WS/" -- "$FUXN_KEYS/.shell" "$FUXN_KEYS/.pick" "$list" sh -c 'fux layout tab - 2>/dev/null; fux layout pane "$1"' sh) || { rm -f "$list"; exit; }
fux layout pane "${p##*/}" 2> /dev/null || :
