#!/bin/sh
# find a tab
# group: Find
# A list of this workspace's tabs (a pane of each, then its panes) in a pane of
# its own; the one chosen is shown. The list is the layout file: a line a tab,
# and `focus=` names the pane of it that has the keys.
list=$(mktemp "$(readlink session)/.pick.XXXXXX") || exit
[ -f workspace/layout ] && awk '{ sub(/^[*-]? */, ""); pane = $NF; sub(/^focus=/, "", pane); if (pane != "") printf "%s\t%s\n", pane, $0 }' workspace/layout > "$list"
exec "$(readlink keys)/.pick" --tab "$list"
