#!/bin/sh
# new workspace
# group: Workspaces
n=1
until said=$(umask 077 && mkdir "$FUX_DIR/w$n" 2>&1); do [ -e "$FUX_DIR/w$n" ] || { echo "$said" >&2; exit 1; }; n=$((n + 1)); done # (the folder made is the claim to the name)
# (Its first shell is started before the viewer is told of it: what is typed after the key is that shell's.)
FUX_WS="w$n" FUX_PANE= "$FUX_KEYS/.new-shell" && echo "workspace w$n"
