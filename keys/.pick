#!/bin/sh
# What a find key runs is `.pick --tab LIST [COMMAND…]`: that starts `.pick LIST COMMAND…` in a pane of its own.
# LIST is a file of lines `KEY<tab>WORDS`. One is chosen, with fzf, sk or fzy if
# one is installed and from a numbered list if none is, and COMMAND is run
# with its KEY as the last argument. The file is moved into the pane's folder, and goes with it.
if [ "$1" = --tab ]; then
  # (With no COMMAND the pane chosen is shown, and the tab shown before the list's
  # own first, so that `fux layout tab -` goes back to that one.)
  [ -s "$2" ] || { rm -f "$2"; echo "nothing to choose"; exit 0; }
  [ $# -gt 2 ] || set -- "$@" sh -c 'fux layout tab - 2>/dev/null; fux layout pane "$1"' sh
  shift
  p=$(fux start -- "$FUX_KEYS/.shell" "$FUX_KEYS/.pick" "$@") || { rm -f "$1"; exit; }
  fux layout pane "${p##*/}" 2> /dev/null
  # Wait briefly until the finder (or numbered list) has drawn its first line, so early keys
  # buffered by the viewer do not arrive before a TUI finder sets raw mode (TCSAFLUSH).
  n=0
  while [ $n -lt 40 ] && [ "$(cat "$p/state" 2>/dev/null)" = running ]; do
    grep -q '[^[:space:]]' "$p/shown/screen" 2>/dev/null && break
    sleep 0.02
    n=$((n + 1))
  done
  exit 0
fi
list=$1; shift
# (The list is in this pane's own folder from here on, and goes with it; if it cannot be moved there, mv has said why, and Enter closes the pane.)
mv "$list" "$FUX_PANE/list" || { rm -f "$list"; read -r _; exit; }
list=$FUX_PANE/list
if finder=$({ command -v fzf || command -v sk || command -v fzy; } 2>/dev/null); then
  line=$("$finder" < "$list") || exit 0
else
  awk '{ printf "%3d  %s\n", NR, $0 }' "$list"
  printf 'which (its number or its name)? '
  IFS= read -r n
  # (A number is a line of the list; one that is no line's number is a name, as any other word is.)
  [ -n "$n" ] || exit
  line=$(name=$n awk -F '\t' 'BEGIN { n = ENVIRON["name"]; number = n ~ /^[0-9]+$/ }
    number && NR == n + 0 && length($0) { pick = $0; exit }
    $1 "" == n "" && !length(pick) { pick = $0; if (!number) exit }
    END { print pick }' "$list")
fi
[ -n "$line" ] || exit
"$@" "${line%%	*}"
