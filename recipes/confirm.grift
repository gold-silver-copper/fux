; Confirm an explicit code value, with its captured arguments if supplied.
(define! call-confirm! (vau! (action arguments) caller
  (apply (evaluate (second (evaluate action caller)) caller) (evaluate arguments caller))))
(define! confirm (lambda! (client title action)
  (define! captured? (same? (kind action) "list"))
  (when! (and!? captured? (not? (same? (length action) 2)))
    (raise (error (quote! bad-value) "a callback is code or (list captured code)" action)))
  (define! captured (if! captured? (first action) ()))
  (define! run (assert-kind (if! captured? (second action) action) "code" "callback code"))
  (assert-kind captured "list" "captured arguments")
  (choose client title (list (list #true "Yes")) () (list 0)
    (list (list run captured) (code! (lambda! (run captured #ignore #ignore)
      (call-confirm! run captured) #inert))))))
