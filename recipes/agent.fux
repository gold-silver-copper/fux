# Tabs for agents, in workspace agent: `require recipes/agent.fux`, or
# `fux --file recipes/agent.fux`, to use its words.
# -- opts : launch options placing new tabs in workspace agent (outside fux, give them a size too: opts str agent in 80 24 size)
define opts str agent in opts str agent in end
# -- answer : a tab with a shell, in workspace agent, on the size of the tab fux runs in (from outside fux: opts 80 24 size str agent in new-tab)
define shell opts str agent in new-tab end
