; A program that asks a question: start it, wait until its prompt shows,
; type the answer, and wait until the reply shows. fux reports each change
; of the pane's version; whether the screen holds what you wait for is
; yours to judge, here by `until-shows`.
; expect: got 5 letters
; pane text -> capture: wait until the pane's screen holds text, from its
; version as it begins (no change is missed), and give that screen as text.
(define! until-shows (lambda! (p text) (string (shows p text 60))))
(define! p (new-tab (argument (argument (program (name (size (in (options) "agent") 60 10) "ask") "sh") "-c") "printf 'name? '; read n; echo got ${#n} letters; read n")))
(until-shows p "name?")
(line p "grift")
(define! answer (last (filter (lambda! (line) (not? (same? line ""))) (string-split (until-shows p "letters") "\n"))))
(kill p)
answer
