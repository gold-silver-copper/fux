# Run a program and read what it printed: `run` answers once the program
# settles, here once it has exited, with its state and its output; as a
# value it is still the pane, so `get` reads how it ended.
# expect: %6 exited 0
# expect: tick 1
# expect: tick 2
# expect: tick 3
# expect: done
# expect: 0

opts str 'sh -c "for i in 1 2 3; do echo tick \$i; sleep 0.1; done; echo done"' command
run dup str exited get
