# Run a program, wait for its exit, and read what it printed: the wait
# answers how it ended; as a value it is still the pane, so `capture`
# reads its screen and `get` how it ended.
# expect: %6 exited 0
# expect: tick 1
# expect: tick 2
# expect: tick 3
# expect: done
# expect: 0

opts str 'sh -c "for i in 1 2 3; do echo tick \$i; sleep 0.1; done; echo done"' command
wait-exit run dup capture over str exited get
