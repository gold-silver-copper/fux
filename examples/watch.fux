# Run a program, wait for its exit, and read what it printed. A wait
# answers each change of the pane's version, from the version run
# answered; the version's last count is 1 once its program ended, and
# `get` reads how it ended.
# expect: tick 1
# expect: tick 2
# expect: tick 3
# expect: done
# expect: 0

opts str 'sh -c "for i in 1 2 3; do echo tick \$i; sleep 0.1; done; echo done"' command
run let W
W string str ' ' split-on 1 at
begin
  dup str . split-on last str 1 eq
  if true else W swap changed 600 timeout wait string str ' ' split-on 1 at false then
until
drop
W capture W str exited get
