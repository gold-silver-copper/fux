# Watch a program's output come in, wait for its last line, and read the
# screen and how it ended.
# expect: tick 1
# expect: tick 2
# expect: tick 3
# expect: done
# expect: 0

opts str 'sh -c "for i in 1 2 3; do echo tick \$i; sleep 0.1; done; echo done"' command
run let TICKS
TICKS str done await
dup opts capture
swap exited str exited get
