# Three programs at once, each exiting with its own status; once all have
# exited, the sum of their statuses. `fux examples/jobs.fux` prints 6.
# expect: 6

# n -- answer: a program that exits with status n; run answers at once,
# with its pane and version, so the next starts at once
define job json opts 80 24 size str sh program str -c arg str 'sleep 0.2; exit "$0"' arg swap arg run end
# answer -- answer: wait from an answer from before its pane's program
# ended until it has (its version's last count is 1), however soon it
# did: a wait on an answer waits from the version it holds
define until-ended
  begin 600 timeout wait dup counts 4 at 1 eq until
end
# answer -- status: once its pane's program has exited
define exit-status until-ended str exited get end

1 job 2 job 3 job
rot exit-status rot exit-status rot exit-status
add add
