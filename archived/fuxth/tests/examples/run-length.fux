# Run-length encoding: each run of one character as a count and the character.
# expect: 3a2b1c4d
# s -- s
define encode
  let s 0 let p
  list str ''
    begin p s len lt while
      s p at let c 0 let n
      begin p s len lt if s p at c eq else false then while p 1 add to p n 1 add to n end
      n string c char
    end
  end concat
end
str aaabbcdddd encode
