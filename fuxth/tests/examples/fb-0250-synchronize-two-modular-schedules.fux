# Synchronize two modular schedules (held-out spec FB-0250).
# expect: 14 9 none 9 4 15 3 7 35
# record -- smallest common time, or none
# Candidates in the first schedule increase by m. Searching below m*n
# covers a whole common period, including non-coprime moduli.
define synchronize
  let record
  record 0 at let a
  record 1 at let m
  record 2 at let b
  record 3 at let n
  m n mul let limit
  a m mod let x
  x 0 lt if x m add let x then
  begin
    x b sub n mod 0 eq if
      true
    else
      x m add let x
      x limit ge
    then
  until
  x limit lt if x else str none then
end

list
  list 2 6 5 9 end
  list 1 4 3 6 end
  list 0 4 3 6 end
  list -1 5 2 7 end
  list 4 8 4 12 end
  list 5 10 0 15 end
  list 3 7 3 7 end
  list 1 1 -2 9 end
  list 11 12 17 18 end
end
each synchronize end
