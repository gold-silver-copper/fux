# Steps between gauge readings (held-out spec FB-0226).
# expect: 5 4 5
# Count adjacent rises, falls, and equal readings.
list 4 4 7 2 2 -1 3 8 8 5 5 9 0 0 1 end let readings
0 let rising
0 let falling
0 let level

1 readings len range each
  let i
  readings i 1 sub at let previous
  readings i at let current
  previous current lt if
    rising 1 add let rising
  else
    previous current gt if
      falling 1 add let falling
    else
      level 1 add let level
    then
  then
end

rising falling level
