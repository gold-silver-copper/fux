# Limited change with minimum pieces (held-out spec FB-0476).
# expect: 4 5 1
# Enumerate each available count triple once; collect its number of coins
# when its value equals the target.
23 let target
list
  0 4 1 add range each let twos
    0 5 1 add range each let threes
      0 2 1 add range each let sevens
        twos 2 mul threes 3 mul add sevens 7 mul add target eq if
          twos threes add sevens add
        then
      end
    end
  end
end let sizes

sizes len
sizes smallest let minimum
minimum
sizes minimum count
