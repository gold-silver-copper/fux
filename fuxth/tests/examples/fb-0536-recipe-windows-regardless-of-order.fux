# Recipe windows regardless of order (held-out spec FB-0536).
# expect: 9 1 2 3 5 6 8 13 14 17
# Compare sorted windows with the sorted recipe to preserve multiplicities.
str 'a b a c a b c a a c b d a c a b a b c a' words let deliveries
str 'a b a c' words let recipe
recipe len let width
recipe sort let target

list
  0 deliveries len width sub 1 add range each
    let start
    deliveries start start width add slice sort target eq if
      start 1 add
    then
  end
end
dup len print
unpack
