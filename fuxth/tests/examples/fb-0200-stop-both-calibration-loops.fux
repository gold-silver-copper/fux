# Stop both calibration loops (held-out spec FB-0200).
# expect: 2 2 83 5
# Traverse rows and cells, terminating both loops on a qualifying quotient.
list
  list 25 20 40 end
  list 16 12 0 end
  list 0 5 10 end
end let matrix
80 let threshold
0 let row-number
0 let evaluated

begin
  matrix row-number at let row
  row-number 1 add let row-number
  0 let column-number
  begin
    1000 row column-number at div let quotient
    column-number 1 add let column-number
    evaluated 1 add let evaluated
    quotient threshold ge column-number row len eq or
  until
  quotient threshold ge row-number matrix len eq or
until

row-number column-number quotient evaluated
