# TWO plus TWO equals FOUR (held-out spec FB-0001).
# expect: 7 7 3 4 1 6 8 734 1468
# digits -- flag: all digits differ.
define distinct
  let digits
  empty let seen
  true let unique
  digits each
    let digit
    seen digit contains if false let unique then
    seen digit push let seen
  end
  unique
end

# Enumerate every three-digit TWO and derive FOUR by doubling it.
list
  100 1000 range each
    let two
    two 100 div let T
    two 10 div 10 mod let W
    two 10 mod let O
    two 2 mul let four
    four 1000 div let F
    four 10 div 10 mod let U
    four 10 mod let R
    F 0 gt four 100 div 10 mod O eq and if
      list T W O F U R end let assignment
      assignment distinct if assignment then
    then
  end
end let solutions

solutions len
solutions smallest let selected
selected
selected 0 at 100 mul selected 1 at 10 mul add selected 2 at add
dup 2 mul
