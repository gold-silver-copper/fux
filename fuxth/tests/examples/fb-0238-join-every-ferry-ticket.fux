# Join every ferry ticket (held-out spec FB-0238).
# expect: HUB -> BAY -> COVE -> HUB -> BAY -> HUB -> DOCK -> HUB -> END 8
# Lexicographic Hierholzer traversal: consume the smallest outgoing edge,
# append stops when retreating, then reverse the resulting route.
str HUB let start
list
  str HUB>END
  str HUB>BAY
  str BAY>HUB
  str HUB>BAY
  str BAY>COVE
  str COVE>HUB
  str HUB>DOCK
  str DOCK>HUB
end let tickets

list tickets each str > split-on end end sort let remaining
list start end let trail
empty let backward

begin
  trail last let current
  -1 let chosen
  0 remaining len range each
    let i
    chosen -1 eq if
      remaining i at first current eq if i let chosen then
    then
  end
  chosen -1 eq if
    trail pop let stop let trail
    backward stop push let backward
  else
    trail remaining chosen at last push let trail
    remaining chosen remove let remaining
  then
  trail len 0 eq
until

backward reverse let route
route str ' -> ' join
route len 1 sub
