# Lowest warehouse reserve (held-out spec FB-0525).
# expect: 6 -1 5
# Track the initial reserve and update only on a strictly lower stock.
23 let stock
stock let lowest
0 let step
0 let earliest

list -8 4 -17 6 -9 14 -5 -9 7 end each
  stock add let stock
  step 1 add let step
  stock lowest lt if
    stock let lowest
    step let earliest
  then
end

stock lowest earliest
