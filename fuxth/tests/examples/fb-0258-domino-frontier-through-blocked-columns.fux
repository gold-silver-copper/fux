# Domino frontier through blocked columns (held-out spec FB-0258).
# expect: 306
# Counts are indexed by the mask of horizontal dominoes entering a column.
# counts blocked -- next-counts
define advance
  let blocked let counts
  list 0 0 0 0 end let next-counts
  0 4 range each
    let incoming
    # An arriving domino must not overlap a blocked cell in either row.
    incoming 2 mod blocked 2 mod mul 0 eq
    incoming 2 div blocked 2 div mul 0 eq and if
      incoming blocked add let occupied
      # Two free cells allow a vertical domino or two outgoing dominoes.
      # Otherwise each remaining free cell requires an outgoing domino.
      occupied 0 eq if
        list 0 3 end
      else
        list 3 occupied sub end
      then
      each
        let outgoing
        next-counts outgoing
        next-counts outgoing at counts incoming at add
        put let next-counts
      end
    then
  end
  next-counts
end

list 1 0 0 0 end
list 0 0 0 1 1 0 0 0 3 0 2 2 0 0 0 0 0 0 0 0 end
each advance end
# No horizontal domino may extend beyond the last column.
0 at
