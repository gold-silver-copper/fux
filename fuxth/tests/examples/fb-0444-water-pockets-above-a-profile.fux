# Water pockets above a profile (held-out spec FB-0444).
# expect: 17 3 1 3 8 5 6 6 8 8 3
# Input heights, from left to right.
4 1 3 0 5 2 2 6 1 4 0
11 pack let heights

# Compute the depth from the greatest height on either side.
list
  0 heights len range each
    let i
    heights 0 i 1 add slice largest
    heights i heights len slice largest
    min heights i at sub
  end
end let depths

# Gather each maximal run of positive depths as start, end, volume.
0 let i
0 let start
0 let volume
list
  depths each
    let depth
    depth 0 gt if
      volume 0 eq if i let start then
      volume depth add let volume
    else
      volume 0 gt if
        list start i 1 sub volume end
        0 let volume
      then
    then
    i 1 add let i
  end
  volume 0 gt if list start i 1 sub volume end then
end let pockets

depths sum
pockets len
pockets each unpack end
