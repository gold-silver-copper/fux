# Stable dispatch tickets (held-out spec FB-0121).
# expect: birch delta copper amber elm
# Tickets in arrival order: priority, name.
list
  list 2 str copper end
  list 1 str birch end
  list 2 str amber end
  list 1 str delta end
  list 3 str elm end
end let tickets

# Include arrival index so equal priorities retain their original order.
list
  0 tickets len range each
    let arrival
    tickets arrival at let ticket
    list ticket first arrival ticket last end
  end
end sort
each last print end
