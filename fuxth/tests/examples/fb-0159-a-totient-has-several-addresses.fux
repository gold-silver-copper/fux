# A totient has several addresses (held-out spec FB-0159).
# expect: 35 39 45 52 56 70 72 78 84 90
# Greatest common divisor for positive inputs, using Euclid's algorithm.
define gcd
  let b let a
  begin
    b 0 eq if true else
      a b mod let remainder
      b let a
      remainder let b
      false
    then
  until
  a
end

# Count integers in [1, n] coprime to n.
define phi
  let n
  0
  1 n 1 add range each
    n gcd 1 eq if 1 add then
  end
end

100 let limit
24 let target
1 limit 1 add range each
  let candidate
  candidate phi target eq if candidate print then
end
