# An octal sum with a divisor (held-out spec FB-0015).
# expect: 1391 2557
# A nonnegative integer's octal digits, most significant first.
define octal-digits
  let n
  list
    begin
      n 8 mod
      n 8 div let n
      n 0 eq
    until
  end
  reverse
end

# Examine positive multiples of 13 in increasing order.
0
begin
  13 add
  dup octal-digits sum 19 eq
until

# Leave the decimal value followed by its octal numeral.
dup octal-digits str '' join
