# Powerful numbers in a closed interval (held-out spec FB-0310).
# expect: 37 6909
# n -- flag: every prime factor has exponent at least two.
define powerful
  let remaining
  2 let divisor
  true let valid
  begin
    divisor divisor mul remaining le valid and if
      0 let exponent
      begin
        remaining divisor mod 0 eq if
          remaining divisor div let remaining
          exponent 1 add let exponent
          false
        else true then
      until
      exponent 1 eq if false let valid then
      divisor 1 add let divisor
      false
    else true then
  until
  # Any remaining prime factor has exponent one; 1 itself passes.
  valid remaining 1 eq and
end

500 let limit
list
  1 limit 1 add range each
    let candidate
    candidate powerful if candidate then
  end
end
dup len swap sum
