# ISBN-10 check digits (held-out spec FB-0714).
# expect: true true false true false false false
# s -- flag: validate an ISBN-10 after removing hyphens.
define isbn-valid
  str - split-on glue let s
  s len 10 eq if
    true let valid
    10 let weight
    0 s each
      let c
      c is-digit if
        c number
      else
        c str X eq weight 1 eq and if
          10
        else
          false let valid
          0
        then
      then
      weight mul add
      weight 1 sub let weight
    end
    11 mod 0 eq valid and
  else
    false
  then
end

list
  str 0-306-40615-2
  str 0-8044-2957-X
  str 0306406153
  str 123456789X
  str X234567890
  str 080442957x
  str 030640615
end
each isbn-valid end
