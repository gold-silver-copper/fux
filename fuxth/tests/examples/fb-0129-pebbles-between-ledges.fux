# Pebbles between ledges (held-out spec FB-0129).
# expect: ...o.. o..#.. #....o .o#..o oo.o.# 3
# Keep the old grid for all movement decisions within a simultaneous round.
list
  str 'o..o.o'
  str '.o.#..'
  str '#o...o'
  str '..#o..'
  str 'o....#'
end let grid
grid len let height
grid first len let width
0 let rounds

begin
  grid let next-grid
  false let moved
  0 height 1 sub range each
    let row
    row 1 add let below
    0 width range each
      let col
      grid row at col at str o eq
      grid below at col at str . eq and if
        next-grid row at col str . put let updated-row
        next-grid row updated-row put let next-grid
        next-grid below at col str o put let updated-row
        next-grid below updated-row put let next-grid
        true let moved
      then
    end
  end
  next-grid let grid
  moved if rounds 1 add let rounds then
  moved not
until

grid unpack
rounds
