# A narrowly defined digit cancellation (held-out spec FB-0485).
# expect: 4 1 100
# Positive integer greatest common divisor, by Euclid's algorithm.
define gcd
  let y let x
  begin
    y 0 ne if
      x y mod let remainder
      y let x
      remainder let y
    then
    y 0 eq
  until
  x
end

1 10 range let digits
0 let matches
1 let product-numerator
1 let product-denominator

# Each triple determines a unique original numerator-denominator pair.
digits each
  let a
  digits each
    let b
    digits each
      let c
      10 a mul c add let numerator
      10 c mul b add let denominator
      numerator denominator lt
      numerator b mul denominator a mul eq and if
        matches 1 add let matches
        product-numerator numerator mul let product-numerator
        product-denominator denominator mul let product-denominator
      then
    end
  end
end

product-numerator product-denominator gcd let divisor
matches
product-numerator divisor div
product-denominator divisor div
