;; fux3-view's commands, in grift, over the viewer's primitives (see the
;; README). The keys in defaults.grift call them by name, and your
;; view.grift may redefine any of them: it is loaded after this.

;; Where the command prompt's text runs.
(define! top (current-context))

;; The viewer's own actions, done at once: `(act "next-tab")`, and with an
;; argument `(act "show-tab" "t3")`; the README lists them.
(define! show-tab (lambda! (tab) (act "show-tab" tab)))
(define! show-workspace (lambda! (space) (act "show-workspace" space)))
(define! run-chord (lambda! (chord) (act "chord" chord)))

;; A pane's program: signals, and ending it, through its ctl file.
(define! signal (lambda! (pane name) (ctl pane (join "signal " name))))
(define! kill (lambda! (pane) (ctl pane "kill")))

;; A layout command (the grammar is in the README), then the tiles it
;; changed resized to fit them in this viewer, once. `arrange` alone edits
;; and resizes nothing.
(define! edit! (lambda! (line) (fit-after (arrange line))))
(define! made (lambda! (text) (line-of "made" text)))
(define! started (lambda! (text) (line-of "started" text)))

;; A pane's name, without the `@ID` of its life.
(define! name-of (lambda! (pane) (first (string-split pane "@"))))

;; The row of `rows` whose first item is `id`.
(define! row-of (lambda! (rows id)
  (let! ((found (filter (lambda! (row) (equal? (first row) id)) rows)))
    (if! (empty-list? found) (raise (error (quote! missing) id)) (first found)))))

;; Places a pane just started with `place`, a function of the pane. If that
;; fails, it says the pane is running and has no tile: it never kills it.
(define! place-new! (lambda! (pane place)
  (catch-kind! (place pane) fux3-error why
    (raise (error (quote! not-placed) (join pane " is running but has no tile") why)))
  (focus pane)))

;; A shell beside the focused pane, on side `dir`: the split starts it.
(define! split-new (lambda! (dir)
  (focus (started (edit! (join "split " (focused) " " dir))))))

;; Takes a pane's tile away, if a tile still has its name.
(define! close-tile (lambda! (pane)
  (if! (empty-list? (filter (lambda! (row) (equal? (name-of (first row)) (name-of pane))) (panes)))
    #inert
    (edit! (join "close " pane)))))

;; The focused pane's history and then its screen (as it is when the key
;; is pressed, without trailing blank rows), as one text in a private file
;; (in a directory of its own in the session's, so what an editor writes
;; beside it goes with it), opened at its end in a pane below: $EDITOR, else
;; $PAGER, else less. The text is a copy: editing it changes nothing in the
;; pane. When the editor ends, the pane removes the file and its recipe
;; (a template never starts one; it is under the name the pane started
;; with) and ends itself, wherever it was moved to (it finds its directory
;; by its id); this viewer then closes its tile.
(define! history-script
  "umask 077; d=\"$FUX3_DIR/.history-$FUX3_PANE_ID\"; f=history-and-screen
trap 'rm -rf \"$d\"' EXIT; trap 'exit 1' HUP INT TERM; mkdir \"$d\" && cd \"$d\" || exit 1
{ if [ -e \"$1.1\" ]; then cat \"$1.1\"; fi; cat \"$1\"; awk 'NR>1{if(/[^ ]/){printf b;print;b=e}else b=b ORS}' \"${1%history}screen\"; } > \"$f\"
e=${EDITOR%% *}; case \"${e##*/}\" in
  vi|vim|nvim|nano|emacs) $EDITOR \"+$(($(wc -l < \"$f\")))\" \"$f\";;
  '') ${PAGER:-less +G} \"$f\";;
  *) $EDITOR \"$f\";;
esac
rm -rf \"$d\" \"$FUX3_DIR/$FUX3_WORKSPACE/.recipes/$FUX3_PANE\"
p=$(grep -lx \"$FUX3_PANE_ID\" \"$FUX3_DIR\"/*/*/id) && echo kill 1<>\"${p%id}ctl\"")
(define! history (lambda! ()
  (let! ((target (focused))
         (file (join (workspace-dir) "/" (name-of target) "/history"))
         (pane (start-new "history" "sh" "-c" history-script "sh" file)))
    (when-gone pane (lambda! () (close-tile pane)))
    (place-new! pane (lambda! (p) (edit! (join "split " target " down " p)))))))

;; Asks, as a list with one row, Yes, and calls `then` only if it is chosen.
(define! confirm (lambda! (question then)
  (pick question (list (list "yes" "Yes")) (lambda! (answer) (then)))))

;; Ends a pane and takes its tile away once it is gone, so the panes that
;; get its room are fitted to what is left; one already gone just loses its
;; tile. A kill that fails otherwise (its ctl full) is said, and the tile
;; stays while the program runs.
(define! close-pane (lambda! (pane)
  (catch-kind! (kill pane) pane-gone gone #inert)
  (when-gone pane (lambda! () (close-tile pane)))))
(define! confirm-close-pane (lambda! (pane)
  (confirm (join "close pane " (name-of pane) "?") (lambda! () (close-pane pane)))))

;; How lists name things: a pane by its name, a tab by its id and title,
;; a workspace by its name (its directory's).
(define! panes-of (lambda! (tab) (filter (lambda! (row) (equal? (second row) tab)) (panes))))
(define! panes-text (lambda! (rows)
  (string-join (map (lambda! (row) (name-of (first row))) rows) ", ")))
(define! tab-row (lambda! (row current)
  (list (first row) (join (first row) " " (second row) " — " (panes-text (panes-of (first row))))
        (equal? (first row) current))))

;; Lists. A tab list renames with r and closes with x; a workspace list
;; closes with x.
(define! choose-tab (lambda! ()
  (let! ((here (shown-tab)))
    (pick "tabs" (map (lambda! (row) (tab-row row here)) (tabs))
      show-tab
      (list (list "r" "rename" rename-tab) (list "x" "close" confirm-close-tab))))))
(define! choose-workspace (lambda! ()
  (let! ((here (shown-workspace)))
    (pick "workspaces" (map (lambda! (name) (list name name (equal? name here))) (workspaces))
      show-workspace
      (list (list "x" "close" confirm-close-workspace))))))
(define! move-to-tab (lambda! (pane)
  (let! ((here (shown-tab)))
    (pick (join "move " (name-of pane) " to tab")
      (map (lambda! (row) (tab-row row here)) (tabs))
      (lambda! (tab) (edit! (join "move " pane " tab " tab)))))))
(define! move-to-new-tab (lambda! (pane)
  (show-tab (made (edit! (join "move " pane " tab new"))))
  (focus pane)))

;; A prompt, filled with the title now.
(define! rename-tab (lambda! (tab)
  (read-line (join "rename tab " tab) (second (row-of (tabs) tab))
    (lambda! (title) (arrange (join "tab rename " tab " " (quote title)))))))

;; Tabs and workspaces: a new one starts with a shell; closing one ends
;; its panes. A new workspace is a directory, named at a prompt; its shell
;; lands in its one tab, as any pane with no tile does.
(define! new-tab (lambda! ()
  (let! ((tab (made (arrange (join "tab new after " (shown-tab))))) (pane (start-new "shell")))
    (show-tab tab)
    (place-new! pane (lambda! (p) (edit! (join "move " p " tab " tab)))))))
(define! new-workspace (lambda! ()
  (read-line "new workspace" ""
    (lambda! (name)
      (if! (empty-list? (filter (lambda! (w) (equal? w name)) (workspaces))) #inert
        (raise (error (quote! exists) (join "workspace " name " exists"))))
      (start-new (join name "/shell"))
      (show-workspace name)))))
(define! end-panes (lambda! (rows)
  (for-each (lambda! (row) (catch-kind! (kill (first row)) pane-gone gone #inert)) rows)))
(define! confirm-close-tab (lambda! (tab)
  (confirm (join "close tab " tab " " (second (row-of (tabs) tab)) "?")
    (lambda! () (end-panes (panes-of tab)) (arrange (join "tab close " tab))))))
(define! confirm-close-workspace (lambda! (space)
  (confirm (join "close workspace " space " and end its panes?")
    (lambda! () (close-workspace space)))))

;; Type grift; the answer shows in the bar's corner.
(define! command-line (lambda! ()
  (read-line ":" ""
    (lambda! (text) (say (value-to-string (evaluate (first (read-form text 0)) top)))))))

;; Every key, to read or to run.
(define! key-list (lambda! ()
  (pick "keys"
    (map (lambda! (b) (list (first b) (join (first b) "  " (second b) "  (" (third b) ")")))
         (key-bindings))
    run-chord)))
