+/// The output path starts absent and every replacement must still be our inode.
+struct StatusFile {
+    path: PathBuf,
+    identity: Option<(u64, u64)>,
+}
+impl StatusFile {
+    fn new(path: PathBuf) -> anyhow::Result<Self> {
+        anyhow::ensure!(path.is_absolute(), "status-file must be absolute");
+        super::validate_directory(
+            path.parent()
+                .ok_or_else(|| anyhow::anyhow!("status-file parent"))?,
+        )?;
+        match std::fs::symlink_metadata(&path) {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            _ => anyhow::bail!("status-file must not already exist"),
+        }
+        Ok(Self {
+            path,
+            identity: None,
+        })
+    }
+    fn write(&mut self, status: &super::status::Status) -> anyhow::Result<()> {
+        use std::{
+            io::Write,
+            os::unix::fs::{MetadataExt, OpenOptionsExt},
+        };
+        if let Some((dev, ino)) = self.identity {
+            let metadata = std::fs::symlink_metadata(&self.path)?;
+            anyhow::ensure!(
+                metadata.is_file() && metadata.dev() == dev && metadata.ino() == ino,
+                "status-file was replaced"
+            );
+        }
+        let candidate = self
+            .path
+            .with_extension(format!("{}.tmp", rand::random::<u64>()));
+        let mut created = None;
+        let result = (|| {
+            let mut file = std::fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(&candidate)?;
+            let metadata = file.metadata()?;
+            created = Some((metadata.dev(), metadata.ino()));
+            let mut bytes = serde_json::to_vec(status)?;
+            bytes.push(b'\n');
+            anyhow::ensure!(bytes.len() <= 2048, "transport status limit");
+            file.write_all(&bytes)?;
+            let metadata = file.metadata()?;
+            std::fs::rename(&candidate, &self.path)?;
+            self.identity = Some((metadata.dev(), metadata.ino()));
+            Ok(())
+        })();
+        if created.is_some_and(|(dev, ino)| {
+            std::fs::symlink_metadata(&candidate)
+                .is_ok_and(|metadata| metadata.dev() == dev && metadata.ino() == ino)
+        }) {
+            let _ = std::fs::remove_file(candidate);
+        }
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::{DirBuilderExt, PermissionsExt};
+
+    #[test]
+    fn status_file_is_private_and_refuses_replacement() -> anyhow::Result<()> {
+        let root = std::path::PathBuf::from(format!("/tmp/koh-status-{}", rand::random::<u64>()));
+        std::fs::DirBuilder::new().mode(0o700).create(&root)?;
+        let result = (|| -> anyhow::Result<()> {
+            let path = root.join("status.json");
+            let mut output = StatusFile::new(path.clone())?;
+            let mut status = super::super::status::Status {
+                v: 1,
+                sequence: 0,
+                connection: 0,
+                state: super::super::status::State::Ready,
+            };
+            output.write(&status)?;
+            anyhow::ensure!(std::fs::metadata(&path)?.permissions().mode() & 0o077 == 0);
+            anyhow::ensure!(StatusFile::new(path.clone()).is_err());
+            status.sequence = 1;
+            status.connection = 1;
+            status.state = super::super::status::State::Unauthorized;
+            output.write(&status)?;
+            let parsed: super::super::status::Status =
+                serde_json::from_slice(&std::fs::read(&path)?)?;
+            anyhow::ensure!(parsed.sequence == 1 && parsed.state == status.state);
+            std::fs::rename(&path, root.join("saved.json"))?;
+            std::fs::write(&path, b"replacement")?;
+            anyhow::ensure!(output.write(&status).is_err());
+            anyhow::ensure!(std::fs::read(&path)? == b"replacement");
+            Ok(())
+        })();
+        std::fs::remove_dir_all(root)?;
+        result
+    }
+}
