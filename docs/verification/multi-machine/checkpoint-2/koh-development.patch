@@ -0,0 +1,103 @@
+//! Bounded, payload-free transport state for process supervisors.
+use serde::{Deserialize, Serialize};
+use std::sync::{
+    atomic::{AtomicU64, Ordering},
+    Arc,
+};
+use tokio::sync::watch;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum State {
+    Ready,
+    Connecting,
+    Connected,
+    Reconnecting,
+    Unauthorized,
+    SessionExpired,
+    SessionEnded,
+    Rejected,
+    Unavailable,
+    Failed,
+    Closed,
+}
+
+/// Latest transition across a gateway's local connections. No application or resume-token data.
+///
+/// `connection` identifies the accepted local stream, not the remote application or TLS peer.
+/// Supervisors must correlate sequence progress with their own requests; Ready is not admission.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Status {
+    pub v: u32,
+    pub sequence: u64,
+    pub connection: u64,
+    pub state: State,
+}
+
+pub(super) struct Hub {
+    sender: watch::Sender<Status>,
+    next: AtomicU64,
+}
+impl Hub {
+    pub(super) fn new() -> (Arc<Self>, watch::Receiver<Status>) {
+        let (sender, receiver) = watch::channel(Status {
+            v: 1,
+            sequence: 0,
+            connection: 0,
+            state: State::Ready,
+        });
+        (
+            Arc::new(Self {
+                sender,
+                next: AtomicU64::new(1),
+            }),
+            receiver,
+        )
+    }
+    pub(super) fn connection(self: &Arc<Self>) -> Option<Reporter> {
+        let connection = self
+            .next
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+                value.checked_add(1)
+            })
+            .ok()?;
+        Some(Reporter {
+            hub: Arc::clone(self),
+            connection,
+        })
+    }
+}
+#[derive(Clone)]
+pub(super) struct Reporter {
+    hub: Arc<Hub>,
+    connection: u64,
+}
+impl Reporter {
+    pub(super) fn set(&self, state: State) {
+        self.hub.sender.send_modify(|status| {
+            status.sequence = status.sequence.saturating_add(1);
+            status.connection = self.connection;
+            status.state = state;
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn status_is_bounded_latest_state_and_connections_remain_distinct() {
+        let (hub, receiver) = Hub::new();
+        let first = hub.connection().expect("first reporter");
+        let second = hub.connection().expect("second reporter");
+        for _ in 0..10_000 {
+            first.set(State::Reconnecting);
+        }
+        second.set(State::Unauthorized);
+        let status = receiver.borrow();
+        assert_eq!(status.sequence, 10_001);
+        assert_eq!(status.connection, 2);
+        assert_eq!(status.state, State::Unauthorized);
+    }
+}
