; The bundled keys, as client configuration.
(bind! "C-b v" "split side by side" "Panes" (code! (lambda! () (split (axis (focused (me)) "horizontal")) #inert)))
(bind! "C-b s" "split stacked" "Panes" (code! (lambda! () (split (axis (focused (me)) "vertical")) #inert)))
(bind! "C-b x" "close pane" "Panes" (code! (lambda! () (confirm-close (me) (focused (me))) #inert)))
(bind! "C-b z" "zoom or restore" "Panes" (code! (lambda! () (zoom (focused (me))) #inert)))
(bind! "C-b c" "history in the editor" "Panes" (code! (lambda! () (edit-history (me)) #inert)))
(bind! "C-b h" "focus left" "Focus" (code! (lambda! () (step (me) (focused (me)) "left") #inert)))
(bind! "C-b j" "focus down" "Focus" (code! (lambda! () (step (me) (focused (me)) "down") #inert)))
(bind! "C-b k" "focus up" "Focus" (code! (lambda! () (step (me) (focused (me)) "up") #inert)))
(bind! "C-b l" "focus right" "Focus" (code! (lambda! () (step (me) (focused (me)) "right") #inert)))
(bind! "C-b o" "next pane" "Focus" (code! (lambda! () (step (me) (focused (me)) "next") #inert)))
(bind! "C-b q" "last pane" "Focus" (code! (lambda! () (step (me) (focused (me)) "last") #inert)))
(bind! "C-b n" "next tab" "Tabs" (code! (lambda! () (step (me) (tab (focused (me))) "next") #inert)))
(bind! "C-b b" "previous tab" "Tabs" (code! (lambda! () (step (me) (tab (focused (me))) "previous") #inert)))
(bind! "C-b t n" "new tab" "Tabs" (code! (lambda! () (new-tab (options)) #inert)))
(bind! "C-b t h" "previous tab" "Tabs" (code! (lambda! () (step (me) (tab (focused (me))) "previous") #inert)))
(bind! "C-b t l" "next tab" "Tabs" (code! (lambda! () (step (me) (tab (focused (me))) "next") #inert)))
(bind! "C-b t g" "choose a tab" "Tabs" (code! (lambda! () (choose-among (me) (tab (focused (me)))) #inert)))
(bind! "C-b t r" "rename tab" "Tabs" (code! (lambda! () (rename-prompt (me) (tab (focused (me)))) #inert)))
(bind! "C-b t x" "close tab" "Tabs" (code! (lambda! () (confirm-close (me) (tab (focused (me)))) #inert)))
(bind! "C-b t m h" "move tab earlier" "Reorder" (code! (lambda! () (reorder (tab (focused (me))) "previous") #inert)))
(bind! "C-b t m l" "move tab later" "Reorder" (code! (lambda! () (reorder (tab (focused (me))) "next") #inert)))
(bind! "C-b w n" "new workspace" "Workspaces" (code! (lambda! () (new-tab (in (options) "new-workspace")) #inert)))
(bind! "C-b w h" "previous workspace" "Workspaces" (code! (lambda! () (step (me) (workspace (focused (me))) "previous") #inert)))
(bind! "C-b w l" "next workspace" "Workspaces" (code! (lambda! () (step (me) (workspace (focused (me))) "next") #inert)))
(bind! "C-b w j" "into a workspace in it" "Workspaces" (code! (lambda! () (show (me) (inner (focused (me)))) #inert)))
(bind! "C-b w k" "out of the workspace" "Workspaces" (code! (lambda! () (outer (me) (focused (me))) #inert)))
(bind! "C-b w g" "choose a workspace" "Workspaces" (code! (lambda! () (choose-among (me) (workspace (focused (me)))) #inert)))
(bind! "C-b w r" "rename workspace" "Workspaces" (code! (lambda! () (rename-prompt (me) (workspace (focused (me)))) #inert)))
(bind! "C-b w x" "close workspace" "Workspaces" (code! (lambda! () (confirm-close (me) (workspace (focused (me)))) #inert)))
(bind! "C-b w m h" "move workspace earlier" "Reorder" (code! (lambda! () (reorder (workspace (focused (me))) "previous") #inert)))
(bind! "C-b w m l" "move workspace later" "Reorder" (code! (lambda! () (reorder (workspace (focused (me))) "next") #inert)))
(bind! "C-b e" "command prompt" "Session" (code! (lambda! () (command-prompt (me)) #inert)))
(bind! "C-b d" "detach" "Session" (code! (lambda! () (detach (me)) #inert)))
(bind! "C-b r h" "shrink or grow left" "Resize" (code! (lambda! () (move-border (focused (me)) "left" 1) #inert)))
(bind! "C-b r j" "shrink or grow down" "Resize" (code! (lambda! () (move-border (focused (me)) "down" 1) #inert)))
(bind! "C-b r k" "shrink or grow up" "Resize" (code! (lambda! () (move-border (focused (me)) "up" 1) #inert)))
(bind! "C-b r l" "shrink or grow right" "Resize" (code! (lambda! () (move-border (focused (me)) "right" 1) #inert)))
(bind! "C-b a r" "rename pane" "Pane actions" (code! (lambda! () (rename-prompt (me) (focused (me))) #inert)))
(bind! "C-b a x" "close pane" "Pane actions" (code! (lambda! () (confirm-close (me) (focused (me))) #inert)))
(bind! "C-b a k" "terminate the running command" "Pane actions" (code! (lambda! () (signal (focused (me)) "TERM") #inert)))
(bind! "C-b a s" "swap with…" "Pane actions" (code! (lambda! () (choose-pane (me) (focused (me))) #inert)))
(bind! "C-b a t" "move to tab…" "Pane actions" (code! (lambda! () (choose-move (me) (focused (me)) (tab (focused (me)))) #inert)))
(bind! "C-b a n" "move to a new tab" "Pane actions" (code! (lambda! () (move (focused (me)) "new-tab") #inert)))
(bind! "C-b a w" "move to workspace…" "Pane actions" (code! (lambda! () (choose-move (me) (focused (me)) (workspace (focused (me)))) #inert)))
(bind! "C-b a W" "move to a new workspace" "Pane actions" (code! (lambda! () (move (focused (me)) "new-workspace") #inert)))
(bind! "C-b a m h" "move pane earlier" "Reorder" (code! (lambda! () (reorder (focused (me)) "previous") #inert)))
(bind! "C-b a m l" "move pane later" "Reorder" (code! (lambda! () (reorder (focused (me)) "next") #inert)))
(bind! "C-b m h" "move left" "Move" (code! (lambda! () (move (focused (me)) "left") #inert)))
(bind! "C-b m j" "move down" "Move" (code! (lambda! () (move (focused (me)) "down") #inert)))
(bind! "C-b m k" "move up" "Move" (code! (lambda! () (move (focused (me)) "up") #inert)))
(bind! "C-b m l" "move right" "Move" (code! (lambda! () (move (focused (me)) "right") #inert)))
(repeat "C-b t m")
(repeat "C-b w m")
(repeat "C-b r")
(repeat "C-b a m")
(repeat "C-b m")
(bind-in "list" "Enter" "choose") (label "select")
(bind-in "list" "y" "choose") (label "select")
(bind-in "list" "q" "cancel") (label "cancel")
(bind-in "list" "n" "cancel") (label "cancel")
(bind-in "list" "j" "down")
(bind-in "list" "k" "up")
(bind-in "list" "Down" "down")
(bind-in "list" "Up" "up")
(bind-in "list" "PageDown" "page-down")
(bind-in "list" "PageUp" "page-up")
(bind-in "list" "Home" "first")
(bind-in "list" "End" "last")
(bind-in "line" "Enter" "submit") (label "accept")
(bind-in "line" "Left" "left")
(bind-in "line" "Right" "right")
(bind-in "line" "Home" "home")
(bind-in "line" "End" "end")
(bind-in "line" "Backspace" "backspace")
(bind-in "line" "Delete" "delete")
(bind-action "r" (code! (lambda! (client target) (rename-prompt client target)))) (label "rename")
(bind-action "x" (code! (lambda! (client target) (confirm-close client target)))) (label "close")
