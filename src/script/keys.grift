; The bundled keys, as client configuration.
(bind-key "C-b v" (code! (lambda! () (split (axis (focused (me)) "horizontal")) #inert))) (label "split side by side") (group "Panes")
(bind-key "C-b s" (code! (lambda! () (split (axis (focused (me)) "vertical")) #inert))) (label "split stacked") (group "Panes")
(bind-key "C-b x" (code! (lambda! () (confirm-close (me) (focused (me))) #inert))) (label "close pane") (group "Panes")
(bind-key "C-b z" (code! (lambda! () (zoom (focused (me))) #inert))) (label "zoom or restore") (group "Panes")
(bind-key "C-b c" (code! (lambda! () (edit-history (me)) #inert))) (label "history in the editor") (group "Panes")
(bind-key "C-b h" (code! (lambda! () (step (me) (focused (me)) "left") #inert))) (label "focus left") (group "Focus")
(bind-key "C-b j" (code! (lambda! () (step (me) (focused (me)) "down") #inert))) (label "focus down") (group "Focus")
(bind-key "C-b k" (code! (lambda! () (step (me) (focused (me)) "up") #inert))) (label "focus up") (group "Focus")
(bind-key "C-b l" (code! (lambda! () (step (me) (focused (me)) "right") #inert))) (label "focus right") (group "Focus")
(bind-key "C-b o" (code! (lambda! () (step (me) (focused (me)) "next") #inert))) (label "next pane") (group "Focus")
(bind-key "C-b q" (code! (lambda! () (step (me) (focused (me)) "last") #inert))) (label "last pane") (group "Focus")
(bind-key "C-b n" (code! (lambda! () (step (me) (tab (focused (me))) "next") #inert))) (label "next tab") (group "Tabs")
(bind-key "C-b b" (code! (lambda! () (step (me) (tab (focused (me))) "previous") #inert))) (label "previous tab") (group "Tabs")
(bind-key "C-b t n" (code! (lambda! () (new-tab (opts)) #inert))) (label "new tab") (group "Tabs")
(bind-key "C-b t h" (code! (lambda! () (step (me) (tab (focused (me))) "previous") #inert))) (label "previous tab") (group "Tabs")
(bind-key "C-b t l" (code! (lambda! () (step (me) (tab (focused (me))) "next") #inert))) (label "next tab") (group "Tabs")
(bind-key "C-b t g" (code! (lambda! () (choose-among (me) (tab (focused (me)))) #inert))) (label "choose a tab") (group "Tabs")
(bind-key "C-b t r" (code! (lambda! () (rename-prompt (me) (tab (focused (me)))) #inert))) (label "rename tab") (group "Tabs")
(bind-key "C-b t x" (code! (lambda! () (confirm-close (me) (tab (focused (me)))) #inert))) (label "close tab") (group "Tabs")
(bind-key "C-b t m h" (code! (lambda! () (reorder (tab (focused (me))) "previous") #inert))) (label "move tab earlier") (group "Reorder")
(bind-key "C-b t m l" (code! (lambda! () (reorder (tab (focused (me))) "next") #inert))) (label "move tab later") (group "Reorder")
(bind-key "C-b w n" (code! (lambda! () (new-tab (in (opts) "new-workspace")) #inert))) (label "new workspace") (group "Workspaces")
(bind-key "C-b w h" (code! (lambda! () (step (me) (workspace (focused (me))) "previous") #inert))) (label "previous workspace") (group "Workspaces")
(bind-key "C-b w l" (code! (lambda! () (step (me) (workspace (focused (me))) "next") #inert))) (label "next workspace") (group "Workspaces")
(bind-key "C-b w j" (code! (lambda! () (show (me) (inner (focused (me)))) #inert))) (label "into a workspace in it") (group "Workspaces")
(bind-key "C-b w k" (code! (lambda! () (outer (me) (focused (me))) #inert))) (label "out of the workspace") (group "Workspaces")
(bind-key "C-b w g" (code! (lambda! () (choose-among (me) (workspace (focused (me)))) #inert))) (label "choose a workspace") (group "Workspaces")
(bind-key "C-b w r" (code! (lambda! () (rename-prompt (me) (workspace (focused (me)))) #inert))) (label "rename workspace") (group "Workspaces")
(bind-key "C-b w x" (code! (lambda! () (confirm-close (me) (workspace (focused (me)))) #inert))) (label "close workspace") (group "Workspaces")
(bind-key "C-b w m h" (code! (lambda! () (reorder (workspace (focused (me))) "previous") #inert))) (label "move workspace earlier") (group "Reorder")
(bind-key "C-b w m l" (code! (lambda! () (reorder (workspace (focused (me))) "next") #inert))) (label "move workspace later") (group "Reorder")
(bind-key "C-b e" (code! (lambda! () (command-prompt (me)) #inert))) (label "command prompt") (group "Session")
(bind-key "C-b d" (code! (lambda! () (detach (me)) #inert))) (label "detach") (group "Session")
(bind-key "C-b r h" (code! (lambda! () (move-border (focused (me)) "left" 1) #inert))) (label "shrink or grow left") (group "Resize")
(bind-key "C-b r j" (code! (lambda! () (move-border (focused (me)) "down" 1) #inert))) (label "shrink or grow down") (group "Resize")
(bind-key "C-b r k" (code! (lambda! () (move-border (focused (me)) "up" 1) #inert))) (label "shrink or grow up") (group "Resize")
(bind-key "C-b r l" (code! (lambda! () (move-border (focused (me)) "right" 1) #inert))) (label "shrink or grow right") (group "Resize")
(bind-key "C-b a r" (code! (lambda! () (rename-prompt (me) (focused (me))) #inert))) (label "rename pane") (group "Pane actions")
(bind-key "C-b a x" (code! (lambda! () (confirm-close (me) (focused (me))) #inert))) (label "close pane") (group "Pane actions")
(bind-key "C-b a k" (code! (lambda! () (signal (focused (me)) "TERM") #inert))) (label "terminate the running command") (group "Pane actions")
(bind-key "C-b a s" (code! (lambda! () (choose-pane (me) (focused (me))) #inert))) (label "swap with…") (group "Pane actions")
(bind-key "C-b a t" (code! (lambda! () (choose-move (me) (focused (me)) (tab (focused (me)))) #inert))) (label "move to tab…") (group "Pane actions")
(bind-key "C-b a n" (code! (lambda! () (move (focused (me)) "new-tab") #inert))) (label "move to a new tab") (group "Pane actions")
(bind-key "C-b a w" (code! (lambda! () (choose-move (me) (focused (me)) (workspace (focused (me)))) #inert))) (label "move to workspace…") (group "Pane actions")
(bind-key "C-b a W" (code! (lambda! () (move (focused (me)) "new-workspace") #inert))) (label "move to a new workspace") (group "Pane actions")
(bind-key "C-b a m h" (code! (lambda! () (reorder (focused (me)) "previous") #inert))) (label "move pane earlier") (group "Reorder")
(bind-key "C-b a m l" (code! (lambda! () (reorder (focused (me)) "next") #inert))) (label "move pane later") (group "Reorder")
(bind-key "C-b m h" (code! (lambda! () (move (focused (me)) "left") #inert))) (label "move left") (group "Move")
(bind-key "C-b m j" (code! (lambda! () (move (focused (me)) "down") #inert))) (label "move down") (group "Move")
(bind-key "C-b m k" (code! (lambda! () (move (focused (me)) "up") #inert))) (label "move up") (group "Move")
(bind-key "C-b m l" (code! (lambda! () (move (focused (me)) "right") #inert))) (label "move right") (group "Move")
(repeat "C-b t m")
(repeat "C-b w m")
(repeat "C-b r")
(repeat "C-b a m")
(repeat "C-b m")
(bind-in "list" "Enter" "choose") (label "select")
(bind-in "list" "y" "choose") (label "select")
(bind-in "list" "q" "cancel") (label "cancel")
(bind-in "list" "n" "cancel") (label "cancel")
(bind-in "list" "j" "down")
(bind-in "list" "k" "up")
(bind-in "list" "Down" "down")
(bind-in "list" "Up" "up")
(bind-in "list" "PageDown" "page-down")
(bind-in "list" "PageUp" "page-up")
(bind-in "list" "Home" "first")
(bind-in "list" "End" "last")
(bind-in "line" "Enter" "submit") (label "accept")
(bind-in "line" "Left" "left")
(bind-in "line" "Right" "right")
(bind-in "line" "Home" "home")
(bind-in "line" "End" "end")
(bind-in "line" "Backspace" "backspace")
(bind-in "line" "Delete" "delete")
(bind-action "r" (code! (lambda! (client target) (rename-prompt client target)))) (label "rename")
(bind-action "x" (code! (lambda! (client target) (confirm-close client target)))) (label "close")
