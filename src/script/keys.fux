
# fux's default keys: a config like yours, run before it. Your config may
# rebind or unbind any of them, or start from none with `unbind-all`. Every
# key here is in the map `C-b`, the prefix, holds; `str C-b str C-a
# move-keys` moves them all to `C-a`. The column lists groups in the order
# they first appear here, `Other` last.
# Its words are your config's and the prompt's too, not the command line's.

# -- client pane : the client whose key runs this, and the pane it focuses
define me-focused me me focused end
# client handle -- : out of the handle's workspace: what holds it shows the client the one it showed before, else the next; at the top none holds it, which refuses
define outer workspace dup str parent get kind str null eq if str 'none holds it' fail then let ws let c str no_workspace try c ws str last step catch drop c ws str next step end end
# handle -- workspace : the first workspace in the handle's, a level in
define inner workspace str children get let kids list kids each dup kind str workspace eq if else drop then end end dup len 0 eq if str 'none is in it' fail then first end
# client handle -- : a prompt for its new name
define rename-prompt
  dup kind str answer eq if pane then let it
  list str 'rename ' it kind str ' ' it string end glue
  it str name get dup kind str string eq not if drop str '' then
  list list it end code rename end end
  prompt
end
# client handle -- : close it, once confirmed: a chooser with one row, Yes, which the client and the row are given to as well
define confirm-close
  dup kind str answer eq if pane then let it
  it str label get let caption
  list str 'close ' it kind str ' ' it string
    caption it string eq not if str ' ' caption then str ?
  end glue
  list list true str Yes end end empty list 0 end
  list list it end code 2drop kill end end choose
end

# record -- row : typed identity and an inert display label, as `listing` shows it
define chooser-row
  let item item str id get let id
  list id list id string item str label get dup id string eq if drop else str ' ' swap then end glue end
end
# records id -- record : an exact held identity; absence refuses before opening
define chooser-find
  string let wanted let records
  list records each dup str id get string wanted eq if else drop then end end
  dup len 1 ne if str 'chooser target is absent or ambiguous' fail then first
end
# snapshot record -- row : a tab/workspace label with its pane summary
define chooser-container-row
  let item let s item chooser-row let row
  item str id get kind str tab eq if list item str id get end
  else item str children get then let tabs
  list s str panes get each let p
    tabs p str tab get contains if p chooser-row last then
  end end str ', ' join let names
  list row first list row last str ' — ' names end glue end
end
# rows id -- index : the current marker, independently optional
define chooser-index
  string let wanted let rows
  list rows len 0 do rows i at first string wanted eq if i then loop end
end
# rows current -- selected : the keys choose an initial row
define chooser-selected
  let current let rows
  current len 0 gt if current else list rows len 0 gt if 0 then end then
end
# snapshot handle -- rows : a row for each of the handle's siblings of its kind, in order, among what holds it
define chooser-siblings
  let it let s
  it kind str workspace eq if str workspaces str parent else
    it kind str tab eq if str tabs str workspace else str panes str tab then
  then let holder let kinds
  s kinds get it chooser-find holder get let held
  list s kinds get each dup holder get held eq if else drop then end end let siblings
  list siblings each
    dup str id get kind str pane eq if chooser-row else s swap chooser-container-row then
  end end
end
# n noun -- s : `1 tab`, `2 tabs`
define chooser-count
  let noun let n list n string str ' ' noun n 1 eq if else str s then end glue
end
# snapshot handle -- ids : the workspace's id and each holding it, as strings
define chooser-path
  let ws let s
  list begin ws kind str null eq not while
    ws string s str workspaces get ws chooser-find str parent get to ws
  end end
end
# snapshot handle -- rows : a row for every workspace on the server, each under what holds it, with what it holds counted; `*` marks the handle's and each holding it
define chooser-tree
  let it let s s it chooser-path let here
  list s str workspaces get each let w
    w str id get let id w str children get let kids
    list kids each kind end end let kinds
    list s str panes get each str tab get kids swap contains end end true count let panes
    list
      kinds str tab count dup 0 gt if str tab chooser-count else drop then
      panes 0 gt if panes str pane chooser-count then
      kinds str workspace count dup 0 gt if str workspace chooser-count else drop then
    end str ', ' join let held
    list id list
      here id string contains if str '* ' else str '  ' then
      str '  ' s id chooser-path len 1 sub copies
      w chooser-row last str ' — ' held
    end glue end
  end end
end
# client handle -- : choose among the handle's siblings, or for a workspace among every workspace (`chooser-tree`), from one topology observation, and show the one chosen
define choose-among
  let it let c all str topology snapshot let s
  it kind str workspace eq let tree
  tree if s it chooser-tree else s it chooser-siblings then let rows
  rows it chooser-index let current
  c list it kind str s end glue rows
  tree if list end current else current rows current chooser-selected then
  code show end choose
end
# client pane handle -- : choose where to move the pane: one of the siblings of handle, a tab or workspace, from one topology observation
define choose-move
  str 'tab workspace' str 'a tab or workspace, where the pane moves' assert-kind
  let it let source let c all str topology snapshot let s
  s str panes get source chooser-find drop
  s it chooser-siblings let rows
  rows it chooser-index let current
  c list list str 'move ' source string str ' to ' it kind end glue source end rows
  current rows current chooser-selected list list source end code nip move end end choose
end
# client pane -- : choose another pane in its tab, from one topology observation
define choose-pane
  let source let c source tab str topology snapshot let s
  s str panes get source chooser-find str tab get let tab-id
  list s str panes get each let item
    item str tab get tab-id eq item str id get string source string ne and if item chooser-row then
  end end let rows
  rows len 0 eq if str 'only one pane in the source tab' fail then
  c list list str 'swap ' source string str ' with' end glue source end rows
  list end list 0 end list list source end code nip swap-with end end choose
end
hide chooser-row hide chooser-find hide chooser-container-row hide chooser-index hide chooser-selected
hide chooser-siblings hide chooser-count hide chooser-path hide chooser-tree

str 'C-b v' code me focused str horizontal axis split drop end bind  str 'split side by side' label  str Panes group
str 'C-b s' code me focused str vertical axis split drop end bind  str 'split stacked' label  str Panes group
str 'C-b x' code me-focused confirm-close end bind  str 'close pane' label  str Panes group
str 'C-b z' code me focused zoom end bind  str 'zoom or restore' label  str Panes group
str 'C-b c' code me edit-history end bind  str 'history in the editor' label  str Panes group

str 'C-b h' code me-focused str left step end bind  str 'focus left' label  str Focus group
str 'C-b j' code me-focused str down step end bind  str 'focus down' label  str Focus group
str 'C-b k' code me-focused str up step end bind  str 'focus up' label  str Focus group
str 'C-b l' code me-focused str right step end bind  str 'focus right' label  str Focus group
str 'C-b o' code me-focused str next step end bind  str 'next pane' label  str Focus group
str 'C-b q' code me-focused str last step end bind  str 'last pane' label  str Focus group

str 'C-b n' code me-focused tab str next step end bind  str 'next tab' label  str Tabs group
str 'C-b b' code me-focused tab str previous step end bind  str 'previous tab' label  str Tabs group
str 'C-b t n' code opts new-tab drop end bind  str 'new tab' label  str Tabs group
str 'C-b t h' code me-focused tab str previous step end bind  str 'previous tab' label  str Tabs group
str 'C-b t l' code me-focused tab str next step end bind  str 'next tab' label  str Tabs group
str 'C-b t g' code me-focused tab choose-among end bind  str 'choose a tab' label  str Tabs group
str 'C-b t r' code me-focused tab rename-prompt end bind  str 'rename tab' label  str Tabs group
str 'C-b t x' code me-focused tab confirm-close end bind  str 'close tab' label  str Tabs group
str 'C-b t m h' code me focused tab str previous reorder end bind  str 'move tab earlier' label  str Reorder group
str 'C-b t m l' code me focused tab str next reorder end bind  str 'move tab later' label  str Reorder group

str 'C-b w n' code opts str new-workspace in new-tab drop end bind  str 'new workspace' label  str Workspaces group
str 'C-b w h' code me-focused workspace str previous step end bind  str 'previous workspace' label  str Workspaces group
str 'C-b w l' code me-focused workspace str next step end bind  str 'next workspace' label  str Workspaces group
str 'C-b w j' code me-focused inner show end bind  str 'into a workspace in it' label  str Workspaces group
str 'C-b w k' code me-focused outer end bind  str 'out of the workspace' label  str Workspaces group
str 'C-b w g' code me-focused workspace choose-among end bind  str 'choose a workspace' label  str Workspaces group
str 'C-b w r' code me-focused workspace rename-prompt end bind  str 'rename workspace' label  str Workspaces group
str 'C-b w x' code me-focused workspace confirm-close end bind  str 'close workspace' label  str Workspaces group
str 'C-b w m h' code me focused workspace str previous reorder end bind  str 'move workspace earlier' label  str Reorder group
str 'C-b w m l' code me focused workspace str next reorder end bind  str 'move workspace later' label  str Reorder group

str 'C-b e' code me command-prompt end bind  str 'command prompt' label  str Session group
str 'C-b d' code me detach end bind  str detach label  str Session group

str 'C-b r h' code me focused str left 1 move-border end bind  str 'shrink or grow left' label  str Resize group
str 'C-b r j' code me focused str down 1 move-border end bind  str 'shrink or grow down' label  str Resize group
str 'C-b r k' code me focused str up 1 move-border end bind  str 'shrink or grow up' label  str Resize group
str 'C-b r l' code me focused str right 1 move-border end bind  str 'shrink or grow right' label  str Resize group

str 'C-b a r' code me-focused rename-prompt end bind  str 'rename pane' label  str 'Pane actions' group
str 'C-b a x' code me-focused confirm-close end bind  str 'close pane' label  str 'Pane actions' group
str 'C-b a k' code me focused str TERM signal drop end bind  str 'terminate the running command' label  str 'Pane actions' group
str 'C-b a s' code me-focused choose-pane end bind  str 'swap with…' label  str 'Pane actions' group
str 'C-b a t' code me-focused dup tab choose-move end bind  str 'move to tab…' label  str 'Pane actions' group
str 'C-b a n' code me focused str new-tab move end bind  str 'move to a new tab' label  str 'Pane actions' group
str 'C-b a w' code me-focused dup workspace choose-move end bind  str 'move to workspace…' label  str 'Pane actions' group
str 'C-b a W' code me focused str new-workspace move end bind  str 'move to a new workspace' label  str 'Pane actions' group
str 'C-b a m h' code me focused str previous reorder end bind  str 'move pane earlier' label  str Reorder group
str 'C-b a m l' code me focused str next reorder end bind  str 'move pane later' label  str Reorder group

str 'C-b m h' code me focused str left move end bind  str 'move left' label  str Move group
str 'C-b m j' code me focused str down move end bind  str 'move down' label  str Move group
str 'C-b m k' code me focused str up move end bind  str 'move up' label  str Move group
str 'C-b m l' code me focused str right move end bind  str 'move right' label  str Move group

# These maps repeat: after one of their keys, the next needs no prefix.
str 'C-b t m' repeat  str 'C-b w m' repeat  str 'C-b r' repeat  str 'C-b a m' repeat  str 'C-b m' repeat

# The keys of fux's own screens: `bind-in` gives a key one of its screen's
# actions, and `label` names it in the screen's hints, the keys of one
# label shown together, in the order bound. Escape always leaves a screen
# (or a line being typed), shown with its action's label.
str list str Enter str choose bind-in  str select label
str list str y str choose bind-in  str select label
str r code rename-prompt end bind-action  str rename label
str x code confirm-close end bind-action  str close label
str list str q str cancel bind-in  str cancel label
str list str n str cancel bind-in  str cancel label
str list str j str down bind-in
str list str k str up bind-in
str list str Down str down bind-in
str list str Up str up bind-in
str list str PageDown str page-down bind-in
str list str PageUp str page-up bind-in
str list str Home str first bind-in
str list str End str last bind-in

str line str Enter str submit bind-in  str accept label
str line str Left str left bind-in
str line str Right str right bind-in
str line str Home str home bind-in
str line str End str end bind-in
str line str Backspace str backspace bind-in
str line str Delete str delete bind-in
