str C-b prefix

# fux's default keys: a config like yours, run before it. Your config may
# rebind or unbind any of them, or start from none with `unbind-all`, and
# change the prefix they follow with `prefix`. The column lists groups in
# the order they first appear here, `Other` last.

str v str 'me focused str horizontal axis split drop' bind  str 'split side by side' label  str Panes group
str s str 'me focused str vertical axis split drop' bind  str 'split stacked' label  str Panes group
str x str 'me me focused confirm-close' bind  str 'close pane' label  str Panes group
str z str 'me zoom' bind  str 'zoom or restore' label  str Panes group
str c str 'me copy-mode' bind  str 'copy and select' label  str Panes group
str p str 'me focused newest paste-buffer drop' bind  str 'paste the newest copy' label  str Panes group

str h str 'me str left focus' bind  str 'focus left' label  str Focus group
str j str 'me str down focus' bind  str 'focus down' label  str Focus group
str k str 'me str up focus' bind  str 'focus up' label  str Focus group
str l str 'me str right focus' bind  str 'focus right' label  str Focus group
str o str 'me str next focus' bind  str 'next pane' label  str Focus group
str q str 'me str last focus' bind  str 'last pane' label  str Focus group

str n str 'me str next step-tab' bind  str 'next tab' label  str Tabs group
str b str 'me str previous step-tab' bind  str 'previous tab' label  str Tabs group
str 't n' str 'opts new-tab drop' bind  str 'new tab' label  str Tabs group
str 't h' str 'me str previous step-tab' bind  str 'previous tab' label  str Tabs group
str 't l' str 'me str next step-tab' bind  str 'next tab' label  str Tabs group
str 't g' str 'me choose-tab' bind  str 'choose a tab' label  str Tabs group
str 't r' str 'me me focused tab rename-prompt' bind  str 'rename tab' label  str Tabs group
str 't x' str 'me me focused tab confirm-close' bind  str 'close tab' label  str Tabs group
str 't m h' str 'me focused tab str previous reorder' bind  str 'move tab earlier' label  str Reorder group  repeat
str 't m l' str 'me focused tab str next reorder' bind  str 'move tab later' label  str Reorder group  repeat

str 'w n' str 'opts new-workspace drop' bind  str 'new workspace' label  str Workspaces group
str 'w h' str 'me str previous step-workspace' bind  str 'previous workspace' label  str Workspaces group
str 'w l' str 'me str next step-workspace' bind  str 'next workspace' label  str Workspaces group
str 'w g' str 'me choose-workspace' bind  str 'choose a workspace' label  str Workspaces group
str 'w r' str 'me me focused workspace rename-prompt' bind  str 'rename workspace' label  str Workspaces group
str 'w x' str 'me me focused workspace confirm-close' bind  str 'close workspace' label  str Workspaces group
str 'w m h' str 'me focused workspace str previous reorder' bind  str 'move workspace earlier' label  str Reorder group  repeat
str 'w m l' str 'me focused workspace str next reorder' bind  str 'move workspace later' label  str Reorder group  repeat

str e str 'me command-prompt' bind  str 'command prompt' label  str Session group
str d str 'me detach' bind  str detach label  str Session group

str 'r h' str 'me focused str left 1 move-border' bind  str 'shrink or grow left' label  str Resize group  repeat
str 'r j' str 'me focused str down 1 move-border' bind  str 'shrink or grow down' label  str Resize group  repeat
str 'r k' str 'me focused str up 1 move-border' bind  str 'shrink or grow up' label  str Resize group  repeat
str 'r l' str 'me focused str right 1 move-border' bind  str 'shrink or grow right' label  str Resize group  repeat

str 'a r' str 'me me focused rename-prompt' bind  str 'rename pane' label  str 'Pane actions' group
str 'a x' str 'me me focused confirm-close' bind  str 'close pane' label  str 'Pane actions' group
str 'a k' str 'me focused str TERM signal drop' bind  str 'terminate the running command' label  str 'Pane actions' group
str 'a s' str 'me me focused choose-pane' bind  str 'swap with…' label  str 'Pane actions' group
str 'a t' str 'me me focused choose-tab-for' bind  str 'move to tab…' label  str 'Pane actions' group
str 'a n' str 'me focused str new-tab move' bind  str 'move to a new tab' label  str 'Pane actions' group
str 'a w' str 'me me focused choose-workspace-for' bind  str 'move to workspace…' label  str 'Pane actions' group
str 'a W' str 'me focused str new-workspace move' bind  str 'move to a new workspace' label  str 'Pane actions' group
str 'a m h' str 'me focused str previous reorder' bind  str 'move pane earlier' label  str Reorder group  repeat
str 'a m l' str 'me focused str next reorder' bind  str 'move pane later' label  str Reorder group  repeat

str 'm h' str 'me focused str left move' bind  str 'move left' label  str Move group  repeat
str 'm j' str 'me focused str down move' bind  str 'move down' label  str Move group  repeat
str 'm k' str 'me focused str up move' bind  str 'move up' label  str Move group  repeat
str 'm l' str 'me focused str right move' bind  str 'move right' label  str Move group  repeat

# The keys of fux's own screens: `bind-in` gives a key one of its screen's
# actions, and `label` names it in the screen's hints, the keys of one
# label shown together, in the order bound. Escape always leaves a screen
# (or a line being typed), shown with its action's label.
str copy str v str select-char bind-in  str select label
str copy str s str select-line bind-in  str select label
str copy str x str select-block bind-in  str select label
str copy str y str yank bind-in  str copy label
str copy str Enter str yank bind-in
str copy str o str other-end bind-in  str 'other end' label
str copy str q str leave bind-in  str quit label
str copy str f str search-forward bind-in  str search label
str copy str r str search-back bind-in  str search label
str copy str n str next bind-in  str next label
str copy str p str previous bind-in  str next label
str copy str h str left bind-in  str move label
str copy str j str down bind-in  str move label
str copy str k str up bind-in  str move label
str copy str l str right bind-in  str move label
str copy str Left str left bind-in
str copy str Down str down bind-in
str copy str Up str up bind-in
str copy str Right str right bind-in
str copy str w str word-forward bind-in  str words label
str copy str b str word-back bind-in  str words label
str copy str u str half-up bind-in  str 'half page' label
str copy str d str half-down bind-in  str 'half page' label
str copy str PageUp str page-up bind-in
str copy str PageDown str page-down bind-in
str copy str t str top bind-in  str 'top bottom' label
str copy str z str bottom bind-in  str 'top bottom' label
str copy str a str first-ink bind-in  str line label
str copy str e str last-ink bind-in  str line label
str copy str End str last-ink bind-in
str copy str Home str line-start bind-in
str copy str [ str prompt-back bind-in  str prompts label
str copy str ] str prompt-forward bind-in  str prompts label

str list str Enter str choose bind-in  str select label
str r str rename-prompt bind-action  str rename label
str x str confirm-close bind-action  str close label
str list str q str cancel bind-in  str cancel label
str list str j str down bind-in
str list str k str up bind-in
str list str Down str down bind-in
str list str Up str up bind-in
str list str PageDown str page-down bind-in
str list str PageUp str page-up bind-in
str list str Home str first bind-in
str list str End str last bind-in

str line str Enter str submit bind-in  str accept label
str line str Left str left bind-in
str line str Right str right bind-in
str line str Home str home bind-in
str line str End str end bind-in
str line str Backspace str backspace bind-in
str line str Delete str delete bind-in

str confirm str y str yes bind-in  str yes label
str confirm str n str no bind-in  str no label
str confirm str q str no bind-in  str no label
