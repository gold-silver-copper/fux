; Saved sessions are one readable grift program over an inert recipe observation.
(define! native-data? (lambda! (value)
  (and!? (symbol? value) (not? (same? value none)) (not? (same? (kind value) "symbol")))))
(define! session-data (lambda! (value)
  (conditional!
    ((native-data? value) (string value))
    ((pair? value) (map session-data value))
    (#true value))))
(define! dump-text (lambda! (text-value) (value-to-string text-value)))
(define! dump-recipe (lambda! (recipe)
  (if! (same? (get recipe "projection") "recipe")
    (join "; Saved by fux; programs inherit the new server's environment.\n"
      (apply join (map dump-warnings (get recipe "panes")))
      "(restore-session (quote! " (value-to-string (session-data recipe)) "))\n")
    (raise (error (quote! type-error) "dump needs a recipe observation" recipe)))))
(define! dump (lambda! (scope)
  (dump-recipe (snapshot (assert-kind scope "pane tab workspace answer closed-answer all" "a pane, tab, workspace or all") "recipe"))))
(define! dump-first (lambda! (nodes index)
  (let! ((node (element-at nodes index)))
    (if! (string? node) node (dump-first nodes (element-at node 3))))))
(define! dump-directory (lambda! (pane-record)
  (let! ((launch (get pane-record "launch")) (current (get pane-record "directory")))
    (if! (and!? (same? (get launch "choice") "shell") (not? (same? current none)) (same? (get current "status") "known"))
      (get current "path") (get launch "directory")))))
(define! dump-warnings (lambda! (pane-record)
  (define! current (get pane-record "directory"))
  (define! unknown (and!? (same? (get (get pane-record "launch") "choice") "shell")
    (or!? (same? current none) (not? (same? (get current "status") "known")))))
  (if! unknown (join "; " (string (get pane-record "id")) ": its current directory is unknown, so it starts in its launch directory\n") "")))
(define! session-find (lambda! (records id)
  (let! ((found (filter (lambda! (record-value) (same? (get record-value "id") id)) records)))
    (if! (same? (length found) 1) (first found) (raise (error (quote! no-target) id))))))
(define! restore-create-options (lambda! (pane-record builder)
  (define! launch (get pane-record "launch"))
  (define! process (get pane-record "program"))
  (when! (same? process none) (raise (error (quote! not-running) (get pane-record "id"))))
  (define! program-arguments (get process "arguments"))
  (define! place (dump-directory pane-record))
  (define! builder (history-bytes builder (get pane-record "history-bytes")))
  (define! builder (reflow builder (get pane-record "reflow")))
  (define! builder (alternate-scroll-lines builder (get pane-record "alternate-scroll-lines")))
  (define! builder (picture-bytes builder (get pane-record "picture-bytes")))
  (define! builder (program-clipboard builder (get pane-record "program-clipboard")))
  (define! builder (directory builder place))
  (if! (same? (get launch "choice") "shell") (shell-program builder program-arguments)
    (program builder program-arguments))))
(define! restore-session (lambda! (recipe)
  (when! (not? (same? (get recipe "projection") "recipe")) (raise (error (quote! type-error) recipe)))
  (define! workspaces (get recipe "workspaces"))
  (define! panes-in (get recipe "panes"))
  ; The workspace the arguments name takes every tab, so one saved workspace at most.
  (define! target (if! (empty-list? (arguments)) none (first (arguments))))
  (when! (and!? (not? (same? target none)) (greater-than? (length workspaces) 1))
    (raise (error (quote! bad-value)
      (join "this saved session has " (integer-to-string (length workspaces))
        " workspaces, and one workspace holds no workspace: run it with no argument"))))
  (define! workspace-map (context ()))
  (define! pane-map (context ()))
  (define! workspace-options (lambda! (id)
    (in (options)
      (conditional!
        ((binds? workspace-map (string-to-symbol id)) (evaluate (string-to-symbol id) workspace-map))
        ((not? (same? target none)) target)
        ((same? (get (session-find workspaces id) "name") none) "new-workspace")
        (#true (get (session-find workspaces id) "name"))))))
  (define! remember-pane (lambda! (record-value new-pane)
    (bind pane-map (string-to-symbol (get record-value "id")) new-pane)
    (when! (not? (same? (get record-value "name") none)) (rename new-pane (get record-value "name")))))
  ; A saved session may say anything, and a restore starts programs: its layouts,
  ; zooms and names against the server and the destination are checked first.
  ; The panes the layouts name, each once.
  (define! named (context ()))
  (define! refuse (lambda! (why)
    (raise (error (quote! bad-value) (join "a saved session's layout " why)))))
  (define! share? (lambda! (value)
    (and!? (integer? value) (greater-than? value 0) (less-than? value 4294967296))))
  ; The tree from node INDEX, DEPTH deep: how many nodes it reaches.
  (define! check-node (lambda! (nodes seen index depth)
    (when! (not? (and!? (integer? index) (not? (less-than? index 0)) (less-than? index (length nodes))))
      (refuse "names a node it does not have"))
    (define! key (string-to-symbol (integer-to-string index)))
    (when! (binds? seen key) (refuse "goes round or reaches a node twice"))
    (bind seen key #true)
    (when! (greater-than? depth 64)
      (raise (error (quote! too-many) "a tab's layout nests at most 64 deep")))
    (define! node (element-at nodes index))
    (conditional!
      ((string? node)
        (session-find panes-in node)
        (when! (binds? named (string-to-symbol node)) (refuse (join "names " node " twice")))
        (bind named (string-to-symbol node) #true)
        1)
      ((and!? (pair? node) (same? (length node) 5))
        (let! ((reached (add (check-node nodes seen (element-at node 3) (add depth 1))
                             (check-node nodes seen (element-at node 4) (add depth 1)))))
          (when! (not? (and!? (member? (first node) (quote! ("horizontal" "vertical")))
                              (share? (second node)) (share? (element-at node 2))))
            (refuse "has a split with a bad axis or share"))
          (add reached 1)))
      (#true (refuse "has a node that is no pane, nor a split of an axis, two shares and two children")))))
  (for-each (lambda! (tab-record)
    (define! nodes (get tab-record "nodes"))
    (session-find workspaces (get tab-record "workspace"))
    (when! (not? (same? (check-node nodes (context ()) 0 0) (length nodes)))
      (refuse "has a node its tree does not reach"))
    (define! zoomed (get tab-record "zoomed"))
    (when! (not? (or!? (same? zoomed none) (member? zoomed (filter string? nodes))))
      (refuse "zooms a pane it does not hold"))) (get recipe "tabs"))
  (for-each (lambda! (pane-record)
    (when! (not? (binds? named (string-to-symbol (get pane-record "id"))))
      (refuse (join "leaves out " (get pane-record "id"))))) panes-in)
  ; The workspace named here takes a name no saved tab or pane may have.
  (when! (not? (same? target none))
    (for-each (lambda! (item)
      (when! (same? (get item "name") target)
        (raise (error (quote! name-taken)
          (join (get item "id") ", saved, is named " target ", the workspace to load into")))))
      (append (get recipe "tabs") panes-in)))
  (define! existing (session-data (snapshot (all) "topology")))
  (define! held (append (get existing "workspaces") (get existing "tabs") (get existing "panes")))
  (define! refuse-taken (lambda! (held) (lambda! (item)
    (let! ((name-value (get item "name")))
      (when! (and!? (not? (same? name-value none)) (member? name-value (map (lambda! (v) (get v "name")) held)))
        (let! ((holder (first (filter (lambda! (v) (same? (get v "name") name-value)) held)))
               (id (get holder "id"))
               (what (conditional! ((same? (slice id 0 1) "%") "pane") ((same? (slice id 0 1) "@") "tab") (#true "workspace"))))
          (raise (error (quote! name-taken) (join id ", a " what ", already named " name-value)))))))))
  (for-each (refuse-taken held) (append (get recipe "tabs") panes-in))
  (when! (same? target none)
    (for-each (refuse-taken (append (get existing "tabs") (get existing "panes"))) workspaces))
  ; Each split made as it was saved: the pane first in a node holds all its room till then.
  (define! restore-node (lambda! (nodes index)
    (let! ((node (element-at nodes index)))
      (when! (not? (string? node))
        (let! ((target (evaluate (string-to-symbol (dump-first nodes (element-at node 3))) pane-map))
               (record-value (session-find panes-in (dump-first nodes (element-at node 4)))))
          (remember-pane record-value (pane (split (restore-create-options record-value
            (shares (axis target (first node)) (second node) (element-at node 2)))))))
        (restore-node nodes (element-at node 3))
        (restore-node nodes (element-at node 4))))))
  (for-each (lambda! (tab-record)
    (define! nodes (get tab-record "nodes"))
    (define! first-id (dump-first nodes 0))
    (define! first-record (session-find panes-in first-id))
    (define! builder (size (workspace-options (get tab-record "workspace")) (get tab-record "columns") (get tab-record "rows")))
    (define! builder (if! (same? (get tab-record "name") none) builder (name builder (get tab-record "name"))))
    (define! first-pane (pane (new-tab (restore-create-options first-record builder))))
    (remember-pane first-record first-pane)
    (bind workspace-map (string-to-symbol (get tab-record "workspace")) (workspace first-pane))
    (restore-node nodes 0)
    (define! new-tab-value (tab first-pane))
    (when! (same? (get tab-record "fit") "clients") (resize-auto new-tab-value))
    (when! (not? (same? (get tab-record "zoomed") none))
      (zoom (evaluate (string-to-symbol (get tab-record "zoomed")) pane-map))))
    (get recipe "tabs"))
  #inert))

; A held observation rendered as a hierarchy, without further remote reads.
(define! listing (lambda! (snapshot-value)
  (define! workspaces (get snapshot-value "workspaces"))
  (define! tabs-in (get snapshot-value "tabs"))
  (define! panes-in (get snapshot-value "panes"))
  (define! identity-key (lambda! (id) (string-to-symbol (string id))))
  (define! record-index (lambda! (records)
    (let! ((index (context ())))
      (for-each (lambda! (record-value) (bind index (identity-key (get record-value "id")) record-value)) records)
      index)))
  (define! tab-index (record-index tabs-in))
  (define! pane-groups (context ()))
  (for-each (lambda! (record-value)
    (let! ((key (identity-key (get record-value "tab"))))
      (bind pane-groups key (pair record-value (lookup pane-groups key ()))))) panes-in)
  (define! scope-kind (kind (get snapshot-value "scope")))
  (define! facts (not? (same? (get snapshot-value "projection") "topology")))
  (define! padding (lambda! (depth) (string-repeat "  " depth)))
  (define! process-state (lambda! (pane-record)
    (if! facts
      (let! ((process (get pane-record "program")))
        (if! (same? process none) ""
          (conditional!
            ((not? (same? (get process "process-id") none)) (join " pid " (integer-to-string (get process "process-id"))))
            ((not? (same? (get process "exited") none)) (join " exited " (integer-to-string (get process "exited"))))
            ((not? (same? (get process "signal") none)) (join " signal " (integer-to-string (get process "signal"))))
            (#true " ended, its status lost")))) "")))
  (define! pane-line (lambda! (pane-record depth)
    (join (padding depth) (second (chooser-row pane-record)) " "
      (integer-to-string (get pane-record "columns")) "x" (integer-to-string (get pane-record "rows"))
      (process-state pane-record))))
  (define! tab-lines (lambda! (tab-record depth)
    (define! children (reverse (lookup pane-groups (identity-key (get tab-record "id")) ())))
    (if! (same? scope-kind "pane") (map (lambda! (pane-record) (pane-line pane-record 0)) children)
      (pair (join (padding depth) (second (chooser-row tab-record)))
        (map (lambda! (pane-record) (pane-line pane-record (add depth 1))) children)))))
  (define! workspace-lines (lambda! (workspace-record)
    (pair (second (chooser-row workspace-record))
      (append-map (lambda! (tab-id) (tab-lines (evaluate (identity-key tab-id) tab-index) 1))
        (get workspace-record "tabs")))))
  (define! whole (member? scope-kind (quote! ("all" "client" "workspace"))))
  (define! hierarchy (if! whole
    (append-map workspace-lines workspaces)
    (append-map (lambda! (record-value) (tab-lines record-value 0)) tabs-in)))
  (define! clients (if! (member? scope-kind (quote! ("all" "client")))
    (append (map (lambda! (client-record)
      (join "client " (string (get client-record "id")) " "
        (integer-to-string (get client-record "columns")) "x" (integer-to-string (get client-record "rows")) " "
        (string-join (map (lambda! (field)
          (let! ((value (get client-record field))) (if! (same? value none) "-" (string value))))
          (quote! ("workspace" "tab" "pane"))) " "))) (get snapshot-value "clients"))
      (list (join "cursor " (get snapshot-value "cursor")))) ()))
  (string-join (append hierarchy clients) "\n")))
(define! events (lambda! (scope cursor-value)
  (let! ((batch (next-events scope cursor-value 3600)))
    (for-each (lambda! (event) (display (value-to-string (session-data event)) "\n")) (batch-events batch))
    (if! (or!? (same? (get batch "status") "gone") (same? (get batch "status") "stopped")) #inert
      (events scope (get batch "next"))))))
