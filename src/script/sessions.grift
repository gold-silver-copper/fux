; Saved sessions are one readable grift program over an inert recipe observation.
(define! native-data? (lambda! (value)
  (and!? (pair? value) (same? (first value) (quote! native-value)))))
(define! native-get get)
(define! get (lambda! (value field)
  (if! (context? value)
    (catch-kind! (evaluate (string-to-symbol field) value) unbound-symbol failure
      (raise (error (quote! no-field) field)))
    (if! (and!? (pair? value) (not? (native-data? value)))
      (let! ((entry (find-association (string-to-symbol field) value)))
        (if! (empty-list? entry) (raise (error (quote! no-field) field)) (second entry)))
      (native-get value field)))))
(define! session-data (lambda! (value)
  (conditional!
    ((context? value) (map (lambda! (entry) (list (first entry) (session-data (second entry)))) (bindings value)))
    ((native-data? value) (string value))
    ((pair? value) (map session-data value))
    (#true value))))
(define! dump-text (lambda! (text-value) (value-to-string text-value)))
(define! dump-recipe (lambda! (recipe)
  (if! (same? (get recipe "projection") "recipe")
    (string-append "; Saved by fux; programs inherit the new server's environment.\n"
      "(restore-session (quote! " (value-to-string (session-data recipe)) "))\n")
    (raise (error (quote! type-error) "dump needs a recipe observation" recipe)))))
(define! dump (lambda! (scope) (dump-recipe (snapshot scope "recipe"))))
(define! dump-first (lambda! (nodes index)
  (let! ((node (element-at nodes index)))
    (if! (string? node) node
      (dump-first nodes (if! (same? (first node) "stack") (first (second node)) (element-at node 3)))))))
(define! dump-cwd (lambda! (pane-record)
  (let! ((launch (get pane-record "launch")) (current (get pane-record "directory")))
    (if! (and!? (same? (get launch "choice") "shell") (not? (same? current none)) (same? (get current "status") "known"))
      (get current "path") (get launch "directory")))))
(define! dump-warnings (lambda! (pane-record)
  (if! (same? (get (dump-cwd pane-record) "encoding") "utf8") ""
    (string-append "directory of " (get pane-record "id") " is not UTF-8; starts in the restore directory"))))
(define! session-find (lambda! (records id)
  (let! ((found (filter (lambda! (record-value) (same? (get record-value "id") id)) records)))
    (if! (same? (length found) 1) (first found) (raise (error (quote! no-target) id))))))
(define! restore-create-options (lambda! (pane-record builder)
  (define! launch (get pane-record "launch"))
  (define! process (get pane-record "program"))
  (when! (same? process none) (raise (error (quote! not-running) (get pane-record "id"))))
  (define! program-arguments (get process "arguments"))
  (define! place (dump-cwd pane-record))
  (define! builder (history-bytes builder (get pane-record "history-bytes")))
  (define! builder (reflow builder (get pane-record "reflow")))
  (define! builder (alternate-scroll-lines builder (get pane-record "alternate-scroll-lines")))
  (define! builder (picture-bytes builder (get pane-record "picture-bytes")))
  (define! builder (program-clipboard builder (get pane-record "program-clipboard")))
  (define! builder (if! (same? (get place "encoding") "utf8") (directory builder (get place "text"))
    (sequence! (warn (dump-warnings pane-record)) builder)))
  (if! (same? (get launch "choice") "shell") (shell-program builder program-arguments)
    (fold (lambda! (builder value) (argument builder value)) (program builder (first program-arguments)) (rest program-arguments)))))
(define! restore-session (lambda! (recipe)
  (when! (not? (same? (get recipe "projection") "recipe")) (raise (error (quote! type-error) recipe)))
  (define! workspaces (get recipe "workspaces"))
  (define! panes-in (get recipe "panes"))
  (define! restore-root (if! (empty-list? (arguments)) (options) (in (options) (first (arguments)))))
  (define! workspace-map (context))
  (define! pane-map (context))
  (define! workspace-options (lambda! (id)
    (if! (binds? workspace-map (string-to-symbol id))
      (in (options) (evaluate (string-to-symbol id) workspace-map))
      (let! ((record-value (session-find workspaces id)) (parent (get record-value "parent"))
             (builder (if! (same? parent none) restore-root (workspace-options parent)))
             (workspace-name (get record-value "name")))
        (in builder (if! (same? workspace-name none) "new-workspace" workspace-name))))))
  (define! remember-workspaces (lambda! (old-id new-workspace)
    (bind workspace-map (string-to-symbol old-id) new-workspace)
    (let! ((parent (get (session-find workspaces old-id) "parent")))
      (when! (not? (same? parent none)) (remember-workspaces parent (get new-workspace "parent"))))))
  (define! remember-pane (lambda! (record-value new-pane)
    (bind pane-map (string-to-symbol (get record-value "id")) new-pane)
    (when! (not? (same? (get record-value "name") none)) (rename new-pane (get record-value "name")))))
  ; Check names before launching anything; top workspaces can be joined.
  (define! existing (session-data (snapshot (all) "topology")))
  (define! held (append (get existing "workspaces") (get existing "tabs") (get existing "panes")))
  (for-each (lambda! (item)
    (let! ((name-value (get item "name")))
      (when! (and!? (not? (same? name-value none)) (member? name-value (map (lambda! (v) (get v "name")) held)))
        (raise (error (quote! name-taken) name-value)))))
    (append (get recipe "tabs") panes-in
      (filter (lambda! (w) (not? (same? (get w "parent") none))) workspaces)))
  (for-each (lambda! (tab-record)
    (define! nodes (get tab-record "nodes"))
    (define! first-id (dump-first nodes 0))
    (define! first-record (session-find panes-in first-id))
    (define! builder (size (workspace-options (get tab-record "workspace")) (get tab-record "columns") (get tab-record "rows")))
    (define! builder (if! (same? (get tab-record "name") none) builder (name builder (get tab-record "name"))))
    (define! first-pane (pane (new-tab (restore-create-options first-record builder))))
    (remember-pane first-record first-pane)
    (remember-workspaces (get tab-record "workspace") (workspace first-pane))
    (for-each (lambda! (node)
      (when! (and!? (string? node) (not? (same? node first-id)))
        (let! ((record-value (session-find panes-in node)))
          (remember-pane record-value (pane (stack (restore-create-options record-value first-pane))))))) nodes)
    (define! new-tab-value (tab first-pane))
    (when! (greater-than? (length nodes) 1)
      (arrange new-tab-value (get new-tab-value "layout-revision")
        (map (lambda! (node) (if! (string? node) (evaluate (string-to-symbol node) pane-map) node)) nodes)))
    (when! (same? (get tab-record "fit") "clients") (resize-auto new-tab-value)))
    (get recipe "tabs"))
  #inert))

; A held observation rendered as a hierarchy, without further remote reads.
(define! append-map (lambda! (function values) (apply append (map function values))))
(define! listing (lambda! (snapshot-value)
  (define! workspaces (get snapshot-value "workspaces"))
  (define! tabs-in (get snapshot-value "tabs"))
  (define! panes-in (get snapshot-value "panes"))
  (define! indent (lambda! (workspace-value)
    (if! (same? workspace-value none) ""
      (string-append "  " (indent (get (chooser-find workspaces workspace-value) "parent"))))))
  (define! workspace-lines (map (lambda! (workspace-value)
    (let! ((id (get workspace-value "id")))
      (string-append (indent (get workspace-value "parent")) (second (chooser-row workspace-value))))) workspaces))
  (define! tab-lines (append-map (lambda! (tab-record)
    (define! tab-id (get tab-record "id"))
    (define! prefix (indent (get tab-record "workspace")))
    (pair (string-append prefix (second (chooser-row tab-record)))
      (map (lambda! (pane-record)
        (string-append prefix "  " (second (chooser-row pane-record)) " "
          (integer-to-string (get pane-record "columns")) "x" (integer-to-string (get pane-record "rows"))))
        (filter (lambda! (pane-record) (equal? (get pane-record "tab") tab-id)) panes-in)))) tabs-in))
  (string-join (append workspace-lines tab-lines) "\n")))
(define! events (lambda! (scope cursor-value)
  (let! ((batch (next-events scope cursor-value 3600)))
    (when! (greater-than? (get batch "missed") 0) (raise (error (quote! journal-loss) batch)))
    (for-each (lambda! (event) (display (value-to-string (session-data event)) "\n")) (get batch "events"))
    (if! (or!? (same? (get batch "status") "gone") (same? (get batch "status") "stopped")) #inert
      (events scope (get batch "next"))))))
