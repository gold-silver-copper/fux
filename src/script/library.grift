; fux policy, loaded the first time one of its words is called.
(define! assert-kind (lambda! (value kinds about)
  (if! (member? (kind value) (string-split kinds " ")) value
       (raise (error (quote! type-error) about value)))))
(define! information (lambda! (scope)
  (snapshot (assert-kind scope "pane tab workspace answer closed-answer all" "a pane, tab, workspace or all") "facts")))
(define! all-history (lambda! (target)
  (history (assert-kind target "pane answer closed-answer pane-request" "a pane or a request on one") 9223372036854775807)))
(define! observed (lambda! (value)
  (conditional!
    ((same? (kind value) "capture") value)
    ((member? (kind value) (quote! ("pane" "answer"))) (capture value))
    (#true (raise (error (quote! type-error) "observed needs a pane, answer or pane capture" value))))))
(define! shows (lambda! (value needle seconds)
  (let! ((seen (observed value)))
    (if! (not? (empty-list? (string-search (string seen) needle 0))) seen
      (if! (same? (get seen "ended") 1)
        (raise (error (quote! ended-before-text) needle))
        (shows (capture (wait (timeout (changed seen) seconds))) needle seconds))))))
(define! quiet (lambda! (value seconds)
  (let! ((seen (observed value)))
    (catch-kind! (quiet (capture (wait (timeout (changed seen) seconds))) seconds)
      timeout failure seen))))
(define! until-ended (lambda! (value seconds)
  (let! ((seen (observed value)))
    (if! (same? (get seen "ended") 1) seen
      (until-ended (capture (wait (timeout (changed seen) seconds))) seconds)))))
(define! grows (lambda! (value count amount seconds)
  (when! (not? (member? count (quote! ("screen" "bells" "done" "ended")))) (raise (error (quote! bad-value) count)))
  (let! ((seen (if! (same? (kind value) "pane") (observed value) value))
         (generation (get seen "respawns")) (goal (add (get seen count) amount))
         (loop (lambda! (sample)
           (if! (not? (same? (get sample "respawns") generation))
             (raise (error (quote! respawned-during-wait) "program respawned during the wait" sample))
             (if! (less-than? (get sample count) goal)
               (loop (wait (timeout (changed sample) seconds))) sample)))))
    (if! (less-than? amount 0) (raise (error (quote! range-error) amount)) (loop seen)))))
(define! list-session (lambda! () (information (all))))
(define! me-focused (lambda! () (list (me) (focused (me)))))
(define! outer (lambda! (client target)
  (let! ((workspace-value (workspace target)))
    (if! (same? (get workspace-value "parent") none) (raise (error (quote! no-workspace) "none holds it" target))
      (catch-kind! (step client workspace-value "last") no-workspace failure
        (step client workspace-value "next"))))))
(define! inner (lambda! (target)
  (let! ((children (filter (lambda! (v) (same? (kind v) "workspace")) (get (workspace target) "children"))))
    (if! (empty-list? children) (raise (error (quote! no-workspace) "none holds it" target)) (first children)))))
(define! rename-prompt (lambda! (client target)
  (let! ((name-value (get target "name")))
    (prompt client (string-append "rename " (kind target) " " (string target))
      (if! (same? name-value none) "" name-value)
      (list (list target) (code! (lambda! (target new-name) (rename target new-name))))))))
(define! confirm-close (lambda! (client target)
  (define! target (if! (same? (kind target) "answer") (pane target) target))
  (define! caption (get target "label"))
  (define! id-text (string target))
  (choose client (string-append "close " (kind target) " " id-text
    (if! (same? caption id-text) "" (string-append " " caption)) "?")
    (list (list #true "Yes")) () (list 0)
    (list (list target) (code! (lambda! (target client payload) (kill target)))))))
(define! chooser-row (lambda! (item)
  (let! ((id (get item "id")) (label (get item "label")))
    (list id (if! (same? (string id) label) label (string-append (string id) " " label))))))
(define! chooser-find (lambda! (records id)
  (let! ((found (filter (lambda! (item) (same? (string (get item "id")) (string id))) records)))
    (if! (same? (length found) 1) (first found) (raise (error (quote! no-target) "chooser target is absent" id))))))
(define! chooser-container-row (lambda! (snapshot-value item)
  (let! ((row (chooser-row item)) (id (first row))
         (tabs-in (if! (same? (kind id) "tab") (list id) (get item "children")))
         (panes-in (filter (lambda! (p) (member? (get p "tab") tabs-in)) (get snapshot-value "panes"))))
    (list id (string-append (second row) " — " (string-join (map (lambda! (p) (second (chooser-row p))) panes-in) ", "))))))
(define! chooser-index (lambda! (rows id)
  (let! ((walk (lambda! (rows index)
    (if! (empty-list? rows) () (if! (same? (string (first (first rows))) (string id)) (list index) (walk (rest rows) (add index 1))))))) (walk rows 0))))
(define! chooser-selected (lambda! (rows current)
  (if! (empty-list? current) (if! (empty-list? rows) () (list 0)) current)))
(define! chooser-siblings (lambda! (snapshot-value target)
  (let! ((type-name (kind target))
         (collection (if! (same? type-name "workspace") "workspaces" (if! (same? type-name "tab") "tabs" "panes")))
         (holder (if! (same? type-name "workspace") "parent" (if! (same? type-name "tab") "workspace" "tab")))
         (records (get snapshot-value collection)) (held (get (chooser-find records target) holder)))
    (map (lambda! (item) (if! (same? type-name "pane") (chooser-row item) (chooser-container-row snapshot-value item)))
      (filter (lambda! (item) (equal? (get item holder) held)) records)))))
(define! chooser-count (lambda! (number noun) (string-append (integer-to-string number) " " noun (if! (same? number 1) "" "s"))))
(define! chooser-path (lambda! (snapshot-value target)
  (if! (same? target none) () (pair (string target) (chooser-path snapshot-value (get (chooser-find (get snapshot-value "workspaces") target) "parent"))))))
(define! chooser-tree (lambda! (snapshot-value target)
  (define! here (chooser-path snapshot-value target))
  (map (lambda! (item)
    (define! id (get item "id"))
    (define! children (get item "children"))
    (define! tab-count (length (filter (lambda! (child) (same? (kind child) "tab")) children)))
    (define! workspace-count (length (filter (lambda! (child) (same? (kind child) "workspace")) children)))
    (define! pane-count (length (filter (lambda! (p) (member? (get p "tab") children)) (get snapshot-value "panes"))))
    (define! held (filter (lambda! (text-value) (not? (same? text-value "")))
      (list (if! (same? tab-count 0) "" (chooser-count tab-count "tab"))
            (if! (same? pane-count 0) "" (chooser-count pane-count "pane"))
            (if! (same? workspace-count 0) "" (chooser-count workspace-count "workspace")))))
    (define! indent (apply string-append (map (lambda! (#ignore) "  ") (range 0 (subtract (length (chooser-path snapshot-value id)) 1)))))
    (list id (string-append (if! (member? (string id) here) "* " "  ") indent
      (second (chooser-row item)) " — " (string-join held ", ")))) (get snapshot-value "workspaces"))))
(define! choose-among (lambda! (client target)
  (let! ((snapshot-value (snapshot (all) "topology"))
         (tree (same? (kind target) "workspace"))
         (rows (if! tree (chooser-tree snapshot-value target) (chooser-siblings snapshot-value target)))
         (current (chooser-index rows target)))
    (choose client (string-append (kind target) "s") rows
      (if! tree () current) (if! tree current (chooser-selected rows current))
      (code! (lambda! (client target) (show client target)))))))
(define! choose-move (lambda! (client source target)
  (define! target (assert-kind target "tab workspace" "a tab or workspace, where the pane moves"))
  (let! ((snapshot-value (snapshot (all) "topology")) (rows (chooser-siblings snapshot-value target)) (current (chooser-index rows target)))
    (chooser-find (get snapshot-value "panes") source)
    (choose client (list (string-append "move " (string source) " to " (kind target)) source) rows current (chooser-selected rows current)
      (list (list source) (code! (lambda! (source client target) (move source target))))))))
(define! choose-pane (lambda! (client source)
  (let! ((snapshot-value (snapshot (tab source) "topology"))
         (tab-id (get (chooser-find (get snapshot-value "panes") source) "tab"))
         (rows (map chooser-row (filter (lambda! (p) (and!? (equal? (get p "tab") tab-id) (not? (same? (string (get p "id")) (string source))))) (get snapshot-value "panes")))))
    (when! (empty-list? rows) (raise (error (quote! fail) "only one pane in the source tab")))
    (choose client (list (string-append "swap " (string source) " with") source) rows () (list 0)
      (list (list source) (code! (lambda! (source client target) (swap-with source target))))))))
(define! edit-history (lambda! (client)
  (let! ((target (focused client))
         (editor (catch-kind! (environment-variable "EDITOR") unset-variable failure "vi"))
         (editor (if! (same? editor "") "vi" editor))
         (builder (argument (program (axis target "vertical") "env") (string-append "FUX_TARGET=" (string target))))
         (builder (argument builder (string-append "EDITOR=" editor)))
         (builder (argument (argument builder "sh") "-c")))
    (split (argument builder "printf '\\033]2;history\\007'; file=$(mktemp) && \"${FUX:-fux}\" '(capture (all-history (pane (first (arguments)))))' \"$FUX_TARGET\" >\"$file\" && $EDITOR \"+$(wc -l <\"$file\")\" \"$file\" || read -r answer; rm -f \"$file\"; \"${FUX:-fux}\" '(kill (here))'"))
    #inert)))
; The strict projection used when an event stream must not skip lost entries.
(define! batch-events (lambda! (batch)
  (when! (greater-than? (get batch "missed") 0)
    (raise (error (quote! journal-loss) (get batch "missed") batch)))
  (get batch "events")))
