# fux's bundled words, written in fuxth: every program may use them.
# `explain NAME` says what each does; a helper is hidden once its users are.

# pane text -- answer : type text into a pane, nothing pressed after it; answers as send-keys does
define type text send-keys end
# pane name -- answer : press a key in a pane: Enter, C-c, Up; answers as send-keys does
define press key send-keys end
# pane text -- answer : in a shell: type a line and press Enter; answers as send-keys does
define line text str Enter key send-keys end
# x kinds about -- x : x, if its kind is one of kinds (names between spaces); else fails, saying it takes about
define assert-kind
  let about fields over kind contains not if
    kind let got list str 'takes ' about str '; its kind is ' got end concat fail
  then
end
# scope -- record : the facts of a pane, tab, workspace or all of the session
define info
  str 'pane tab workspace answer closed-answer all' str 'a pane, tab, workspace or all' assert-kind
  str facts snapshot
end
# pane-builder -- pane-builder : capture: all the history first
define all-history
  str 'pane answer closed-answer pane-request' str 'a pane or a request on one' assert-kind
  9223372036854775807 history
end
# pane-or-seen -- list : the five counts of a pane or held version: respawns screen bells done ended
define counts
  version str : split-on 1 at str . split-on let parts
  list parts each str '#' swap cat number end end
end
# pane-or-observation -- capture : retain a pane capture without refreshing it, otherwise sample a pane or single answer; client captures and requests are refused
define observed
  dup kind str capture eq if else
    dup kind str pane eq over kind str answer eq or
    if capture else str 'observed needs a pane, answer or pane capture' fail then
  then
end
# pane-or-observation text secs -- capture : check first, then plain shown screens after changes; old text and input echo can match; timeout is per change
define shows
  let secs let needle observed
  begin dup string needle contains not while
    dup counts 4 at 1 eq if str 'program ended before the text showed' fail then
    changed secs timeout wait capture
  end
end
# pane-or-observation secs -- capture : last sample after secs with no version change; only timeout is caught; metadata belongs to that saved sample, not the end of the interval
define quiet
  let secs observed
  begin
    let seen
    str timeout try seen changed secs timeout wait capture false
    catch drop seen true end
  until
end
# pane-or-observation secs -- capture : checks ended first, even with unknown status; follows the pane across respawns; timeout is per change
define until-ended
  let secs observed
  begin dup counts 4 at 1 eq not while changed secs timeout wait capture end
end
# pane-or-seen index amount secs -- observation : growth within one program generation, failing across respawn; index 1..4, nonnegative amount; a bare pane is sampled first; timeout is per change
define grows
  let secs let amount let index
  index 1 lt index 4 gt or if str 'count index must be 1..4' fail then
  amount 0 lt if str 'count growth must be nonnegative' fail then
  dup kind str pane eq if observed then
  dup counts let before
  before 0 at let generation
  before index at amount add let goal
  goal before index at lt if str 'count growth past what an integer holds' fail then
  begin
    dup counts let now
    now 0 at generation ne if str 'program respawned during count wait' fail then
    now index at goal lt
  while changed secs timeout wait end
end
# client -- : its focused pane's history in this client's $EDITOR (else vi), opened at its last line (+LINE, which vi, vim, nvim, nano and emacs take), in a split titled history and closed when the editor exits; after a failure, Enter closes it. env(1) gives the program the pane's id and the editor, and "${FUX:-fux}" is the server's fux
define edit-history
  focused let p
  str unset_var try str EDITOR getenv catch drop str vi end
  dup str '' eq if drop str vi then let editor
  p str vertical axis
  str env program  list str FUX_TARGET= p string end glue arg
  list str EDITOR= editor end glue arg
  str sh arg  str -c arg
  str 'printf "\033]2;history\007"; f=$(mktemp) && "${FUX:-fux}" "$FUX_TARGET" all-history capture >"$f" && $EDITOR "+$(($(wc -l <"$f")))" "$f" || read -r _; rm -f "$f"; "${FUX:-fux}" here kill' arg
  split drop
end
# client handle -- : a prompt for its new name
define rename-prompt
  dup kind str answer eq if pane then let it
  list str 'rename ' it kind str ' ' it string end glue
  it str name get dup kind str string eq not if drop str '' then
  list list it end code rename end end
  prompt
end
# client handle -- : close it, once confirmed: a chooser with one row, Yes, which the client and the row are given to as well
define confirm-close
  dup kind str answer eq if pane then let it
  it str label get let caption
  list str 'close ' it kind str ' ' it string
    caption it string eq not if str ' ' caption then str ?
  end glue
  list list true str Yes end end empty list 0 end
  list list it end code 2drop kill end end choose
end

# -- record : one facts observation of all workspaces, tabs, panes and clients
define ls all info end

# record -- row : typed identity and an inert display label
define chooser-row
  let item item str id get let id
  list id list id string item str label get dup id string eq if drop else str ' ' swap then end glue end
end
# record -- string : a held snapshot hierarchy, each workspace's tabs and workspaces under it; facts and recipes include process outcomes
define listing
  let s s str scope get kind let sk
  s str projection get str topology ne let facts
  s str workspaces get let wss s str panes get let panes
  list wss each str id get end end let wids
  sk str all eq sk str client eq or let clients
  clients sk str workspace eq or let whole
  sk str pane eq let one
  # Workspaces come before those in them: a row before its first tab's.
  list -1 end wss each str parent get wids swap index-of 1 add over swap at 1 add push end let depths
  0 let wi 0 let pi
  list
    s str tabs get each let t
      t str id get let tid
      wids t str workspace get index-of let x
      whole if
        begin wi x gt not while
          list depths wi 1 add at 0 do str '  ' loop wss wi at chooser-row last end glue wi 1 add let wi
        end
      then
      list whole if depths x 1 add at 1 add 0 do str '  ' loop then end glue let indent
      one not if indent t chooser-row last cat then
      one if str '' else indent str '  ' cat then let indent
      begin pi panes len lt if panes pi at str tab get tid eq else false then while
        panes pi at let p
        list indent p chooser-row last str ' '
          p str cols get string str x p str rows get string
          facts if p str program get let pr pr kind str null ne if
            pr str pid get kind str null ne if str ' pid ' pr str pid get string else
            pr str exited get kind str null ne if str ' exited ' pr str exited get string else
            pr str signal get kind str null ne if str ' signal ' pr str signal get string else
            str ' ended, its status lost' then then then
          then then
        end glue
        pi 1 add let pi
      end
    end
    clients if
      s str clients get each let c
        list str 'client ' c str id get string str ' ' c str cols get string str x c str rows get string str ' '
          list list str workspace str tab str pane end each
            c swap get dup kind str null eq if drop str - then string
          end end str ' ' join
        end glue
      end
      list str 'cursor ' s str cursor get end glue
    then
  end 10 char join
end

# text -- source : a string literal, never executable data
define dump-text let text list str 'str ' text quote str ' ' end glue end
# handle -- source : a local replay binding, independent of the new server's ids
define dump-id
  dup kind str workspace eq if str w else str p then let prefix
  string dup len 1 swap slice prefix swap cat
end
# nodes index -- pane : the first leaf of a flat subtree, without recursive calls
define dump-first
  swap let nodes
  begin nodes swap at dup is-list while dup first str stack eq if 1 at first else 3 at then end
end
# pane-record -- path : a shell starts again where it is now, when that is known; else, as a program always does, where it was started
define dump-cwd
  let p p str launch get let launch launch str cwd get
  launch str choice get str shell eq if
    p str cwd get let now
    now kind str null ne if now str status get str known eq if drop now str path get then then
  then
end
# pane-record -- source : warnings for unknown directories and non-text directories
define dump-warnings
  let p
  list
    p str launch get str choice get str shell eq if
      p str cwd get dup kind str null eq
      if drop true else str status get str known ne then
      if str '# ' p str id get string str ': its current directory is unknown, so it starts in its launch directory' 10 char then
    then
    p dump-cwd let cwd
    cwd str encoding get str utf8 ne if
      str '# ' p str id get string str ': directory bytes (hex) ' cwd str text get
      str ' are not UTF-8 text; it starts where this runs' 10 char
    then
  end glue
end
# pane source -- source : restore a given name; a null name emits nothing
define dump-name
  let name let target
  name kind str null eq if str '' else
    list target str ' ' name dump-text str rename 10 char end glue
  then
end
# pane-record prefix action -- source : one complete creation, including its saved options and launch role
define dump-create
  let action let prefix let p p str launch get let launch p str state get let state
  p str program get dup kind str null eq if
    list p str id get string str ' holds no program while a respawn lets its old one go: dump it once the new one takes its place' end glue fail
  then str argv get let argv
  list
    p dump-warnings
    prefix
    state str history_bytes get string str ' history-bytes '
    state str reflow get string str ' reflow '
    state str alternate_scroll_lines get string str ' alternate-scroll-lines '
    state str picture_bytes get string str ' picture-bytes '
    state str program_clipboard get string str ' program-clipboard '
    p dump-cwd let cwd
    cwd str encoding get str utf8 eq if cwd str text get dump-text str 'cwd ' then
    launch str choice get str shell eq if
      str 'list ' argv each dump-text end str 'end shell-program '
    else
      true let first-arg argv each
        dump-text first-arg if str 'program ' false let first-arg else str 'arg ' then
      end
    then
    action str ' let ' p str id get dump-id 10 char
    p str id get dump-id p str name get dump-name
  end glue
end
# recipe -- source : serialize one held recipe; flat traversal retains the exact tree and shares
define dump-recipe
  let recipe
  recipe str projection get str recipe ne if str 'dump needs a recipe snapshot' fail then
  recipe str panes get let panes
  list panes each str id get end end let ids
  recipe str workspaces get let wss
  list wss each str id get end end let wids
  list end list end wss each
    dup str parent get wids swap index-of 0 lt if rot swap push swap else push then
  end let inner let tops
  0 let wi
  list
    str '#!/usr/bin/env -S fux --file
# fux: running this makes it again; its programs take the environment of the server that runs them.
# Its workspaces go in the workspace its first argument names, else at the top.
args len 0 gt if opts args first in else opts then let top
'
    str 'list ' tops each
      str name get dup kind str null eq if drop else dump-text then
    end str 'end let joins' 10 char
    str 'list ' recipe str tabs get panes cat inner cat each
      str name get dup kind str null eq if drop else dump-text then
    end str 'end let names' 10 char
    str '# Refused before anything is made if a name it gives is taken here; a workspace of its name is joined.
all str topology snapshot let s
list s str tabs get each str name get end s str panes get each str name get end end let held
list s str workspaces get each str name get end end let workspaces
list joins each held over contains if else drop then end
  names each held over contains workspaces 2 pick contains or if else drop then end end
# A tab named as the workspace it would make is refused (name_taken), whether that name is free or not.
dup len 0 gt if first let taken opts taken in taken name 80 24 size str / cwd new-tab else drop then
'
    recipe str tabs get each
      let tab
      tab str nodes get let nodes
      nodes 0 dump-first let first-pane
      panes ids first-pane index-of at let p
      # Workspaces come before those in them: those from wi to its own are made with it.
      wids tab str workspace get index-of let x
      x wi lt if tab str workspace get else wss wi at str parent get then let up
      x 1 add wi max let upto
      list
        wids up index-of 0 lt if str 'top ' else str 'opts ' up dump-id cat str ' in ' cat then
        upto wi do wss i at str name get dup kind str null eq if drop str new-workspace then dump-text str 'in ' loop
        tab str name get dup kind str null eq if drop else dump-text str 'name ' then
        tab str cols get string str ' ' tab str rows get string str ' size '
      end glue let prefix
      p prefix str new-tab dump-create
      upto wi gt if
        list first-pane dump-id str ' workspace' upto wi do
          str ' dup let ' wss x wi add i sub at str id get dump-id str ' str parent get'
        loop str ' drop' 10 char end glue
      then
      upto let wi
      tab str fit get str clients eq if first-pane dump-id str ' tab resize-auto' 10 char then
      # The other panes made in a stack with the first, then laid out as they were.
      nodes len 1 gt if
        nodes each dup is-list if drop else
          dup first-pane eq if drop else
            panes ids rot index-of at list first-pane dump-id str ' ' end glue str stack dump-create
          then
        then end
        list first-pane dump-id str ' tab dup str layout_revision get list' nodes each
          str ' ' swap dup is-list if
            dup first str stack eq if
              str 'list str stack list ' swap 1 at each string str ' ' end str 'end end'
            else
              str 'list ' swap dup first dump-text swap 1 5 slice each string str ' ' end str 'end'
            then
          else dump-id then
        end str ' end arrange' 10 char end glue
      then
    end
  end glue
end
# scope -- text : a tab, workspace or all, as one bounded recipe making new processes; the complete source is built before output
define dump
  str 'pane tab workspace answer closed-answer all' str 'a pane, tab, workspace or all' assert-kind
  str recipe snapshot dump-recipe string
end
hide dump-text hide dump-id hide dump-first hide dump-cwd hide dump-warnings
hide dump-name hide dump-create hide dump-recipe

# Timeout is an observation outcome, never evidence that a program is ready.
# Each wait is an hour at most, then asked again from where it got to.
# event-scope cursor -- : its events, a JSON object a line, each with its next, till the scope is gone or the server stops; empty cursor starts now; loss fails
define events
  let cursor let scope
  begin
    scope cursor 3600 next-events let batch
    batch str missed get 0 gt if
      list batch str missed get string
        str ' journal entries missed; resnapshot before continuing' end glue fail
    then
    batch str events get each json print end
    batch str next get let cursor
    batch str status get dup str gone eq swap str stopped eq or
  until
end

# records id -- record : an exact held identity; absence refuses before opening
define chooser-find
  string let wanted let records
  list records each dup str id get string wanted eq if else drop then end end
  dup len 1 ne if str 'chooser target is absent or ambiguous' fail then first
end
# snapshot record -- row : a tab/workspace label with its pane summary
define chooser-container-row
  let item let s item chooser-row let row
  item str id get kind str tab eq if list item str id get end
  else item str children get then let tabs
  list s str panes get each let p
    tabs p str tab get contains if p chooser-row last then
  end end str ', ' join let names
  list row first list row last str ' — ' names end glue end
end
# rows id -- index : the current marker, independently optional
define chooser-index
  string let wanted let rows
  list rows len 0 do rows i at first string wanted eq if i then loop end
end
# rows current -- selected : the library chooses an initial row
define chooser-selected
  let current let rows
  current len 0 gt if current else list rows len 0 gt if 0 then end then
end
# snapshot handle -- rows : a row for each of the handle's siblings of its kind, in order, among what holds it
define chooser-siblings
  let it let s
  it kind str workspace eq if str workspaces str parent else
    it kind str tab eq if str tabs str workspace else str panes str tab then
  then let holder let kinds
  s kinds get it chooser-find holder get let held
  list s kinds get each dup holder get held eq if else drop then end end let siblings
  list siblings each
    dup str id get kind str pane eq if chooser-row else s swap chooser-container-row then
  end end
end
# client handle -- : choose among the handle's siblings from one topology observation, and show the one chosen
define choose-among
  let it let c all str topology snapshot it chooser-siblings let rows
  rows it chooser-index let current
  c list it kind str s end glue rows current rows current chooser-selected code show end choose
end
# client pane handle -- : choose where to move the pane: one of the siblings of handle, a tab or workspace, from one topology observation
define choose-move
  str 'tab workspace' str 'a tab or workspace, where the pane moves' assert-kind
  let it let source let c all str topology snapshot let s
  s str panes get source chooser-find drop
  s it chooser-siblings let rows
  rows it chooser-index let current
  c list list str 'move ' source string str ' to ' it kind end glue source end rows
  current rows current chooser-selected list list source end code nip move end end choose
end
# client pane -- : choose another pane in its tab, from one topology observation
define choose-pane
  let source let c source tab str topology snapshot let s
  s str panes get source chooser-find str tab get let tab-id
  list s str panes get each let item
    item str tab get tab-id eq item str id get string source string ne and if item chooser-row then
  end end let rows
  rows len 0 eq if str 'only one pane in the source tab' fail then
  c list list str 'swap ' source string str ' with' end glue source end rows
  list end list 0 end list list source end code nip swap-with end end choose
end
hide chooser-row hide chooser-find hide chooser-container-row hide chooser-index hide chooser-selected
hide chooser-siblings
