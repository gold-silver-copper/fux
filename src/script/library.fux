# fux's bundled words, written in fuxth: every program may use them.
# `explain NAME` says what each does.

# pane text -- answer : type text into a pane, nothing pressed after it; answers as send-keys does
define type text send-keys end
# pane name -- answer : press a key in a pane: Enter, C-c, Up; answers as send-keys does
define press key send-keys end
# pane text -- answer : in a shell: type a line and press Enter; answers as send-keys does
define line text str Enter key send-keys end
# pane -- capture : the pane's screen as it is now
define screen capture end
# -- pane : a tab with a shell, in workspace agent
define shell opts str agent in new-tab end
# version -- list : the five counts of a version, an action's or wait's answer, or its text: respawns screen bells done ended
define counts string words first str : split-on 1 at str . split-on let parts list parts each number end end end
# subject secs -- subject : wait from it (a pane from now, an answer from its version) until nothing changes there for secs seconds: the answer of the last change, else it
define quiet
  let secs
  begin
    let since
    str timeout try since secs timeout wait false catch 2drop since true end
  until
end
