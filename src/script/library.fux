# fux's bundled words, written in fuxth: every program may use them.
# `explain NAME` says what each does.

# -- : attach, naming a first workspace main when the server is empty
define default-attach opts attach end
# pane text -- answer : type text into a pane, nothing pressed after it; answers as send-keys does
define type text send-keys end
# pane name -- answer : press a key in a pane: Enter, C-c, Up; answers as send-keys does
define press key send-keys end
# pane text -- answer : in a shell: type a line and press Enter; answers as send-keys does
define line text str Enter key send-keys end
# -- opts : launch options explicitly placing new tabs in workspace agent
define agent-opts opts str agent in end
# -- answer : a tab with a shell, in workspace agent, on the size of the tab fux runs in (from outside fux: opts 80 24 size str agent in new-tab)
define shell agent-opts new-tab end
# pane-or-seen -- list : the five counts of a pane or held version: respawns screen bells done ended
define counts
  version str : split-on 1 at str . split-on let parts
  list parts each number end end
end
# pane secs -- : wait from it (a pane from now, an answer or str V changed from its version) until nothing changes there for secs seconds
define quiet
  let secs
  begin
    let since
    str timeout try since secs timeout wait false catch 2drop since true end
  until
  drop
end
# client handle -- : a prompt for its new name
define rename-prompt
  dup kind str answer eq if pane then let it
  list str 'rename ' it kind str ' ' it string end glue
  it str name get dup kind str string eq not if drop str '' then
  list list it end str rename end
  prompt
end
# client handle -- : close it, once confirmed
define confirm-close
  dup kind str answer eq if pane then let it
  it str label get let caption
  list str 'close ' it kind str ' ' it string
    caption it string eq not if str ' ' caption then str ?
  end glue
  list list it end str kill end
  confirm
end

# -- id : choose the newest paste buffer when the request runs
define newest str newest end

# -- record : one facts observation of all workspaces, tabs, panes and clients
define ls all info end

# way -- way : a checked layout axis, independent of how many panes there are
define layout-axis
  dup str horizontal eq over str vertical eq or not
  if str 'layout axis must be horizontal or vertical' fail then
end
# Empty input is an error; list/step/weight bounds apply before arrange submits anything.
# panes way alternate base -- tree : balanced flat nodes with absolute child indices; leaves share room by pane count
define layout-of
  let base let alternate layout-axis let way let ps
  ps len let n
  n 0 eq if str 'a layout needs at least one pane' fail then
  n 1 eq if list ps first end else
    n 2 div let a n a sub let b
    alternate if
      way str horizontal eq if str vertical else str horizontal then
    else way then let next-way
    list list way a b base 1 add base a 2 mul add end end
    ps 0 a slice next-way alternate base 1 add layout-of cat
    ps a n slice next-way alternate base a 2 mul add layout-of cat
  then
end
# panes way -- tree : balanced equal-share row or column, rejecting empty input
define even-of false 0 layout-of end
# panes way cross -- tree : first pane takes two shares, the rest one, evenly along cross
define main-of
  layout-axis let cross layout-axis let way let ps
  ps len 0 eq if str 'a layout needs at least one pane' fail then
  ps len 1 eq if list ps first end else
    list list way 2 1 1 2 end ps first end
    ps 1 ps len slice cross false 2 layout-of cat
  then
end
# panes -- tree : balanced tiles, alternating axes, room shared by pane count
define tiled-of str horizontal true 0 layout-of end

# records id -- record : an exact held identity; absence refuses before opening
define chooser-find
  string let wanted let records
  list records each dup str id get string wanted eq if else drop then end end
  dup len 1 ne if str 'chooser target is absent or ambiguous' fail then first
end
# record -- row : typed identity and an inert display label
define chooser-row
  let item item str id get let id
  list id list id string item str label get dup id string eq if drop else str ' ' swap then end glue end
end
# snapshot record -- row : a tab/workspace label with its pane summary
define chooser-container-row
  let item let s item chooser-row let row
  item str id get kind str tab eq if list item str id get end
  else item str tabs get then let tabs
  list s str panes get each let p
    tabs p str tab get contains if p chooser-row last then
  end end str ', ' join let names
  list row first list row last str ' — ' names end glue end
end
# rows id -- index : the current marker, independently optional
define chooser-index
  string let wanted let rows
  list 0 rows len range each let n rows n at first string wanted eq if n then end end
end
# rows current -- selected : the library chooses an initial row
define chooser-selected
  let current let rows
  current len 0 gt if current else list rows len 0 gt if 0 then end then
end
# client -- : choose a tab in the client's workspace from one topology observation
define choose-tab
  let c c str topology snapshot let s
  s str clients get c chooser-find let place
  list s str tabs get each
    dup str workspace get place str workspace get eq if s swap chooser-container-row else drop then
  end end let rows
  rows place str tab get chooser-index let current
  c str tabs rows current rows current chooser-selected str show choose
end
# client -- : choose a workspace from one topology observation
define choose-workspace
  let c all str topology snapshot let s
  s str clients get c chooser-find let place
  list s str workspaces get each s swap chooser-container-row end end let rows
  rows place str workspace get chooser-index let current
  c str workspaces rows current rows current chooser-selected str show choose
end
# client pair -- : move the source to its actual typed destination
define chooser-move nip dup first swap last move end
# client pair -- : swap the source with its actual typed destination
define chooser-swap nip dup first swap last swap-with end
# rows source -- rows : carry the source alongside each destination
define chooser-source
  let source let rows
  list rows each let row list list source row first end row last end end end
end
# client pane -- : choose a destination tab from one topology observation
define choose-tab-for
  let source let c all str topology snapshot let s
  s str panes get source chooser-find drop
  s str clients get c chooser-find let place
  list s str tabs get each
    dup str workspace get place str workspace get eq if s swap chooser-container-row else drop then
  end end let rows
  rows place str tab get chooser-index let current
  c list list str 'move ' source string str ' to tab' end glue source end rows source chooser-source
  current rows current chooser-selected str chooser-move choose
end
# client pane -- : choose a destination workspace from one topology observation
define choose-workspace-for
  let source let c all str topology snapshot let s
  s str panes get source chooser-find drop
  s str clients get c chooser-find let place
  list s str workspaces get each s swap chooser-container-row end end let rows
  rows place str workspace get chooser-index let current
  c list list str 'move ' source string str ' to workspace' end glue source end rows source chooser-source
  current rows current chooser-selected str chooser-move choose
end
# client pane -- : choose another pane in its tab, from one topology observation
define choose-pane
  let source let c source str topology snapshot let s
  s str panes get source chooser-find str tab get let tab-id
  list s str panes get each let item
    item str tab get tab-id eq item str id get string source string ne and if item chooser-row then
  end end let rows
  rows len 0 eq if str 'only one pane in the source tab' fail then
  c list list str 'swap ' source string str ' with' end glue source end rows source chooser-source
  list end list 0 end str chooser-swap choose
end
# client payload -- : list actions address a destination handle, including move/swap rows
define chooser-target
  dup is-list if last then
  dup kind let type-name
  type-name str pane eq type-name str tab eq or type-name str workspace eq or not
  if str 'this list row has no pane, tab or workspace target' fail then
end
# client payload -- : rename the selected target through a typed callback
define chooser-rename chooser-target rename-prompt end
# client payload -- : close the selected target through a typed callback
define chooser-close chooser-target confirm-close end
