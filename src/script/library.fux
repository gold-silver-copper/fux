# fux's bundled words, written in fuxth: every program may use them.
# `explain NAME` says what each does.

# -- : attach, naming a first workspace main when the server is empty
define default-attach opts attach end
# pane text -- answer : type text into a pane, nothing pressed after it; answers as send-keys does
define type text send-keys end
# pane name -- answer : press a key in a pane: Enter, C-c, Up; answers as send-keys does
define press key send-keys end
# pane text -- answer : in a shell: type a line and press Enter; answers as send-keys does
define line text str Enter key send-keys end
# -- opts : launch options explicitly placing new tabs in workspace agent
define agent-opts opts str agent in end
# -- answer : a tab with a shell, in workspace agent, on the size of the tab fux runs in (from outside fux: opts 80 24 size str agent in new-tab)
define shell agent-opts new-tab end
# pane-or-seen -- list : the five counts of a pane or held version: respawns screen bells done ended
define counts
  version str : split-on 1 at str . split-on let parts
  list parts each number end end
end
# pane secs -- : wait from it (a pane from now, an answer or str V changed from its version) until nothing changes there for secs seconds
define quiet
  let secs
  begin
    let since
    str timeout try since secs timeout wait false catch 2drop since true end
  until
  drop
end
# client handle -- : a prompt for its new name
define rename-prompt
  dup kind str answer eq if pane then let it
  list str 'rename ' it kind str ' ' it string end glue
  it str name get dup kind str string eq not if drop str '' then
  list it string str ' swap rename' end glue
  prompt
end
# client handle -- : close it, once confirmed
define confirm-close
  dup kind str answer eq if pane then let it
  it str label get let caption
  list str 'close ' it kind str ' ' it string
    caption it string eq not if str ' ' caption then str ?
  end glue
  list it string str ' kill' end glue
  confirm
end

# -- id : choose the newest paste buffer when the request runs
define newest str newest end

# -- record : one facts observation of all workspaces, tabs, panes and clients
define ls all info end

# text -- source : a string literal, never executable data
define dump-text let text list str 'str ' text quote str ' ' end glue end
# handle -- source : a local replay binding, independent of the new server's ids
define dump-id
  dup kind str workspace eq if str w else str p then let prefix
  string dup len 1 swap slice prefix swap cat
end
# nodes index -- pane : the first leaf of a flat subtree, without recursive calls
define dump-first
  swap let nodes
  begin nodes swap at dup is-list if 3 at false else true then until
end
# pane-record -- source : warnings for unknown directories and omitted non-text launch inputs
define dump-warnings
  let p p str launch get let launch
  list
    launch str choice get str shell eq if
      launch str observed_cwd get dup kind str null eq
      if drop true else str status get str known ne then
      if str '# ' p str id get string str ': its current directory is unknown, so it starts in its launch directory' 10 char then
    then
    launch str env get each
      let e e str value get let v
      v kind str null ne if v str encoding get str utf8 ne if
        e str name get dump-text str 'drop # ' p str id get string
        str ': environment is not UTF-8 text; its saved value is omitted' 10 char
      then then
    end
    launch dump-cwd let cwd
    cwd str encoding get str utf8 ne if
      str '# ' p str id get string str ': directory bytes (hex) ' cwd str text get
      str ' are not UTF-8 text; it starts where this runs' 10 char
    then
  end glue
end
# launch -- path : shells prefer observed cwd; programs always keep launch cwd
define dump-cwd
  let launch launch str initial_cwd get let cwd
  launch str choice get str shell eq if
    launch str observed_cwd get let observed
    observed kind str null ne if observed str status get str known eq if
      observed str path get let cwd
    then then
  then
  cwd
end
# pane-record prefix action -- source : one complete creation, including its saved options and launch role
define dump-create
  let action let prefix let p p str launch get let launch
  list
    p dump-warnings
    prefix
    launch str history_bytes get string str ' history-bytes '
    launch str reflow get string str ' reflow '
    launch str alternate_scroll_lines get string str ' alternate-scroll-lines '
    launch str picture_bytes get string str ' picture-bytes '
    launch str program_clipboard get string str ' program-clipboard list end copy-environment '
    launch dump-cwd let cwd
    cwd str encoding get str utf8 eq if cwd str text get dump-text str 'cwd ' then
    launch str env get each
      let e e str value get let v
      v kind str null eq if e str name get dump-text str 'unset-env ' else
        v str encoding get str utf8 eq if
          e str name get dump-text v str text get dump-text str 'env '
        then
      then
    end
    launch str choice get str shell eq if
      str 'list ' launch str argv get each dump-text end str 'end shell-program '
    else
      true let first-arg launch str argv get each
        dump-text first-arg if str 'program ' false let first-arg else str 'arg ' then
      end
    then
    action str ' let ' p str id get dump-id 10 char
    p str id get dump-id p str name get dump-name
  end glue
end
# pane source -- source : restore a given name; a null name emits nothing
define dump-name
  let name let target
  name kind str null eq if str '' else
    list target str ' ' name dump-text str rename 10 char end glue
  then
end
# recipe -- source : serialize one held recipe; flat traversal retains the exact tree and shares
define dump-recipe
  let recipe
  recipe str projection get str recipe ne if str 'dump needs a recipe snapshot' fail then
  recipe str panes get let panes
  list panes each str id get end end let ids
  list
    str '#!/usr/bin/env -S fux --file' 10 char
    str '# fux: running this makes it again; environment patches apply to the server startup environment.' 10 char
    recipe str workspaces get each
      let ws true let opens
      recipe str tabs get each
        let tab tab str workspace get ws str id get eq if
          tab str nodes get let nodes
          nodes 0 dump-first let first-pane
          panes ids first-pane index-of at let p
          list
            str 'opts '
            opens if
              ws str name get dup kind str null eq if drop else dump-text str 'in ' then
            else ws str id get dump-id str ' in ' then
            tab str cols get string str ' ' tab str rows get string str ' size '
          end glue let prefix
          p prefix opens ws str name get kind str null eq and
            if str new-workspace else str new-tab then dump-create
          opens if
            first-pane dump-id str ' workspace let ' ws str id get dump-id 10 char
            false let opens
          then
          first-pane dump-id str ' tab' cat tab str name get dump-name
          tab str fit get str clients eq if first-pane dump-id str ' tab resize-auto' 10 char then
          list 0 end let pending
          begin pending len 0 gt if
            pending pop let index let pending
            nodes index at dup is-list if
              let node nodes node 3 at dump-first let before
              nodes node 4 at dump-first let after
              panes ids after index-of at
              list before dump-id str ' ' node 0 at dump-text str 'axis '
                node 1 at string str ' ' node 2 at string str ' shares ' end glue
              str split dump-create
              pending node 4 at push node 3 at push let pending
            else drop then
            false
          else true then until
        then
      end
    end
  end glue
end
# scope -- text : a tab, workspace or all, as one bounded recipe making new processes; the complete source is built before output
define dump str recipe snapshot dump-recipe string end

# way -- way : a checked layout axis, independent of how many panes there are
define layout-axis
  dup str horizontal eq over str vertical eq or not
  if str 'layout axis must be horizontal or vertical' fail then
end
# Empty input is an error; list/step/weight bounds apply before arrange submits anything.
# panes way alternate base -- tree : balanced flat nodes with absolute child indices; leaves share room by pane count
define layout-of
  let base let alternate layout-axis let way let ps
  ps len let n
  n 0 eq if str 'a layout needs at least one pane' fail then
  n 1 eq if list ps first end else
    n 2 div let a n a sub let b
    alternate if
      way str horizontal eq if str vertical else str horizontal then
    else way then let next-way
    list list way a b base 1 add base a 2 mul add end end
    ps 0 a slice next-way alternate base 1 add layout-of cat
    ps a n slice next-way alternate base a 2 mul add layout-of cat
  then
end
# panes way -- tree : balanced equal-share row or column, rejecting empty input
define even-of false 0 layout-of end
# panes way cross -- tree : first pane takes two shares, the rest one, evenly along cross
define main-of
  layout-axis let cross layout-axis let way let ps
  ps len 0 eq if str 'a layout needs at least one pane' fail then
  ps len 1 eq if list ps first end else
    list list way 2 1 1 2 end ps first end
    ps 1 ps len slice cross false 2 layout-of cat
  then
end
# panes -- tree : balanced tiles, alternating axes, room shared by pane count
define tiled-of str horizontal true 0 layout-of end
