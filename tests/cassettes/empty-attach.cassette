# fux cassette 1
# guards: an untargeted headless attach to an empty server starts one
#   workspace, its shell laid out on the attach's screen below the bar,
#   and the client ends when detached
# fix: #317
$ fux ls str workspaces get len
  = 0
  ~ 0
$ fux opts 100 30 size attach >"$DIR/attach.out" 2>&1 & echo $! >"$DIR/attach.pid"
$ until fux str c1 client capture >/dev/null 2>&1; do sleep 0.05; done
$ fux ls str workspaces get len
  = 1
  ~ 1
$ fux ls str panes get first let p p str cols get p str rows get
  = 100
  = 29
  ~ 100
  ~ 29
$ fux str c1 client detach
$ wait "$(cat "$DIR/attach.pid")"; cat "$DIR/attach.out"
  = ca
  = [detached]
  ~ ca
  ~ [detached]
