# fux cassette 1
# guards: two clients step through workspaces and tabs on their own, each
#   with its own last, and a tab's zoom is the focus of every client shown
#   it, each client's own coming back when it ends
$ V=$(fux '(new-tab (name (size (in (options) "one") 80 24) "a"))'); P=${V%%:*}
$ fux '(new-tab (name (size (in (options) "one") 80 24) "b"))' >/dev/null
$ fux '(new-tab (size (in (options) "two") 80 24))' >/dev/null
$ clients() { fux '(length (get (list-session) "clients"))'; }
$ fux '(attach (size (in (options) "one") 100 30))' >/dev/null &
$ until [ "$(clients)" = 1 ]; do sleep 0.05; done
$ fux '(attach (size (in (options) "one") 60 20))' >/dev/null &
$ until [ "$(clients)" = 2 ]; do sleep 0.05; done
$ where() { for c in c1 c2; do echo "$c $(fux '(get (workspace (focused (client (first (arguments))))) "name")' "$c") $(fux '(get (tab (focused (client (first (arguments))))) "name")' "$c")"; done; }
$ fux '(step (client "c1") (tab "a") "next")'; fux '(step (client "c2") (workspace "one") "next")'; where
  = ca one b
  = cb two none
  ~ ca one b
  ~ cb two none
$ fux '(step (client "c2") (workspace "two") "last")'; fux '(step (client "c1") (tab "b") "last")'; where
  = ca one a
  = cb one a
  ~ ca one a
  ~ cb one a
$ Q=$(fux "(split (axis (pane \"$P\") \"horizontal\"))"); Q=${Q%%:*}; fux "(step (client \"c1\") (pane \"$Q\") \"left\")"; fux "(zoom (pane \"$Q\"))"
$ for c in c1 c2; do [ "$(fux '(focused (client (first (arguments))))' "$c")" = "$Q" ] && echo "$c focuses the zoomed pane"; done
  = ca focuses the zoomed pane
  = cb focuses the zoomed pane
  ~ ca focuses the zoomed pane
  ~ cb focuses the zoomed pane
$ fux "(zoom (pane \"$Q\"))"; [ "$(fux '(focused (client "c1"))')" = "$P" ] && [ "$(fux '(focused (client "c2"))')" = "$Q" ] && echo "each its own"
  = each its own
  ~ each its own
$ fux "(zoom (pane \"$Q\"))"; fux "(step (client \"c2\") (pane \"$Q\") \"left\")"; fux '(get (first (get (information (tab "a")) "tabs")) "zoomed")'
  = none
  ~ none
