# fux cassette 1
# guards: two clients shown different workspaces nested in one project step
#   among their own siblings, each with its own place, and the project's
#   words cover what is in the workspaces in it
$ fux '(new-tab (size (in (options) "home") 80 24))' >/dev/null
$ fux '(new-tab (name (size (in (in (options) "proj") "agent1") 80 24) "a"))' >/dev/null
$ fux '(new-tab (name (size (in (in (options) "proj") "agent2") 80 24) "b"))' >/dev/null
$ fux '(new-tab (name (size (in (options) "agent2") 80 24) "c"))' >/dev/null
$ clients() { fux '(length (get (list-session) "clients"))'; }
$ fux '(attach (size (in (options) "agent1") 100 30))' >/dev/null &
$ until [ "$(clients)" = 1 ]; do sleep 0.05; done
$ fux '(attach (size (in (options) "agent2") 60 20))' >/dev/null &
$ until [ "$(clients)" = 2 ]; do sleep 0.05; done
$ where() { for c in c1 c2; do echo "$c $(fux '(get (workspace (focused (client (first (arguments))))) "name")' "$c") $(fux '(get (tab (focused (client (first (arguments))))) "name")' "$c")"; done; }
$ where
  = ca agent1 a
  = cb agent2 b
  ~ ca agent1 a
  ~ cb agent2 b
$ C=$(fux '(get (information (workspace "proj")) "cursor")')
$ fux '(step (client "c1") (workspace "agent1") "next")'; fux '(step (client "c2") (tab "b") "next")'; where
  = ca agent2 b
  = cb agent2 c
  ~ ca agent2 b
  ~ cb agent2 c
$ fux '(step (client "c1") (workspace "agent2") "last")'; where
  = ca agent1 a
  = cb agent2 c
  ~ ca agent1 a
  ~ cb agent2 c
$ fux '(map (lambda! (t) (get t "name")) (tabs (workspace "proj")))'
  = a
  = b
  = c
  ~ a
  ~ b
  ~ c
$ fux '(define! batch (next-events (workspace "proj") (first (arguments)) 0)) (map (lambda! (e) (get e "client")) (filter (lambda! (e) (same? (get e "event") "shown")) (get batch "events")))' "$C"
  = ca
  = ca
  = cb
  = cb
  = ca
  = ca
  ~ ca
  ~ ca
  ~ cb
  ~ cb
  ~ ca
  ~ ca
