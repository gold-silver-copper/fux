# fux cassette 1
# guards: a wait from a version the pane has already moved past answers that
#   change at once, never waiting for another
# exercises: wait-across-change
$ V=$(fux '(new-tab (argument (argument (program (size (in (options) "agent") 80 24) "sh") "-c") "read x; echo \"got=$x\"; read y"))')
$ fux "(send-keys (key (text (pane \"${V%%:*}\") \"x\") \"Enter\"))"
  ~ %a:0.0.0.0.0:R1
$ until fux "(capture (pane \"${V%%:*}\"))" | grep -q '^got=x'; do sleep 0.05; done
$ fux "(wait (timeout (changed \"$V\") 1))"
  = %a:0.*.0.0.0:R1 screen
  ~ %a:0.10.0.0.0:R1 screen
