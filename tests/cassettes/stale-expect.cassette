# fux cassette 1
# guards: keys sent with expect at a version the pane has moved past are
#   refused stale, and none of them reach the program
# exercises: stale-expect
$ V=$(fux agent-opts 80 24 size str sh program str -c arg str 'read x; read y; echo "second=$y"' arg new-tab)
$ fux "${V%%:*}" str x text str Enter key send-keys
  ~ %a:0.0.0.0.0:R1
$ fux str "$V" changed 5 timeout wait
  ~ %a:0.3.0.0.0:R1 screen
$ fux str "$V" expect str y text str Enter key send-keys
  [1] stale
$ fux "${V%%:*}" str z text str Enter key send-keys
  ~ %a:0.3.0.0.0:R1
$ fux "${V%%:*}" 5 until-ended | grep '^second='
  = second=z
  ~ second=z
@journal
  = event=exited pane=%a exited=0
  ~ {"event":"created","workspace":"+a","name":"agent","origin":{"kind":"unknown"}}
  ~ {"event":"created","tab":"@a","workspace":"+a","name":null,"origin":{"kind":"unknown"}}
  ~ {"event":"created","pane":"%a","tab":"@a","workspace":"+a","origin":{"kind":"unknown"}}
  ~ {"event":"exited","pane":"%a","tab":"@a","workspace":"+a","exited":0,"origin":{"kind":"program","pane":"%a","generation":0}}
