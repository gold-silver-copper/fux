# fux cassette 1
# guards: keys sent with expect at a version the pane has moved past are
#   refused stale, and none of them reach the program
# exercises: stale-expect
$ V=$(fux '(new-tab (argument (argument (program (size (in (options) "agent") 80 24) "sh") "-c") "read x; read y; echo \"second=$y\""))')
$ fux "(send-keys (key (text (pane \"${V%%:*}\") \"x\") \"Enter\"))"
  ~ %a:0.0.0.0.0:R1
$ fux "(wait (timeout (changed \"$V\") 5))"
  ~ %a:0.3.0.0.0:R1 screen
$ fux "(send-keys (key (text (expect \"$V\") \"y\") \"Enter\"))"
  [1] stale
$ fux "(send-keys (key (text (pane \"${V%%:*}\") \"z\") \"Enter\"))"
  ~ %a:0.3.0.0.0:R1
$ fux "(until-ended (pane \"${V%%:*}\") 5)" | grep '^second='
  = second=z
  ~ second=z
@journal
  = event=exited pane=%a exited=0
  ~ {"event":"created","workspace":"+a","name":"agent","origin":{"kind":"outside"}}
  ~ {"event":"created","tab":"@a","workspace":"+a","name":null,"origin":{"kind":"outside"}}
  ~ {"event":"created","pane":"%a","tab":"@a","workspace":"+a","origin":{"kind":"outside"}}
  ~ {"event":"exited","pane":"%a","tab":"@a","workspace":"+a","exited":0,"origin":{"kind":"program","pane":"%a","generation":0}}
