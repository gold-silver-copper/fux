# fux cassette 1
# guards: json of a capture past 1,000,000 characters is an ordinary string,
#   which len and slice take
# fix: #313
$ V=$(fux '(new-tab (argument (argument (program (history-bytes (size (in (options) "agent") 120 40) 33554432) "sh") "-c") "seq 1 200000"))')
$ fux "(until-ended (pane \"${V%%:*}\") 20) #inert"
$ fux "(greater-than? (string-byte-length (data-text (capture (all-history (pane \"${V%%:*}\"))))) 1000000)"
  = #true
  ~ #true
$ fux "(byte-substring (data-text (capture (all-history (pane \"${V%%:*}\")))) 0 8)"
  = ((kind "
  ~ ((kind "
