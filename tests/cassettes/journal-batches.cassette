# fux cassette 1
# guards: the journal read on from each batch's next, as text through the
#   CLI, gives every event once: all of them in one batch, none missed
# fix: #320
$ C=$(fux '(get (next-events (all) "" 0) "next")')
$ fux - <<'EOF'
> (define! p (new-tab (argument (argument (program (size (in (options) "agent") 80 24) "sh") "-c") "read x")))
> (for-each (lambda! (n) (rename p (integer-to-string n))) (range 0 70))
> EOF
$ fux - <<EOF
> (define! one (next-events (all) "$C" 0))
> (print (length (get one "events"))) (print (get one "status"))
> (define! two (next-events (all) (get one "next") 0))
> (print (length (get two "events"))) (print (get two "missed"))
> (print (length (get (next-events (all) (get two "next") 0) "events")))
> EOF
  = 73
  = continuing
  = 0
  = 0
  = 0
  ~ 73
  ~ continuing
  ~ 0
  ~ 0
  ~ 0
