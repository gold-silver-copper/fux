# fux cassette 1
# guards: the journal read on from each batch's next, as text through the
#   CLI, gives every event once: all of them in one batch, none missed
# fix: #320
$ C=$(fux all str '' 0 next-events str next get)
$ fux - <<'EOF'
> opts str agent in 80 24 size str sh program str -c arg str 'read x' arg new-tab let p
> 0 begin p over string rename 1 add dup 70 eq until drop
> EOF
$ fux - <<EOF
> all str $C 0 next-events let one
> one str events get len print one str status get print
> all one str next get 0 next-events let two
> two str events get len print two str missed get print
> all two str next get 0 next-events str events get len print
> EOF
  = 73
  = continuing
  = 0
  = 0
  = 0
  ~ 73
  ~ continuing
  ~ 0
  ~ 0
  ~ 0
