# The save replaced the target, its name whole, and the link stays. One
# test a line, as bash -e runs it.
target=$(printf 'target\n.'); target=${target%.}
[ -L notes.txt ]
[ "$(cat "$target")" = newold ]
# Two files and no temporary one, counted by a glob: ls may print the
# line end as `?`.
shopt -s dotglob; files=(*); [ "${#files[@]}" -eq 2 ]
